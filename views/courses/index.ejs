<!-- courses/index.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Courses</h1>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary"><%= total || 0 %> courses</span>
      <a href="/courses/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg"></i> Add Course
      </a>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

<!-- Search & Filter -->
   <div class="row">
     <div class="col-12">
       <button class="btn btn-outline-secondary my-3 filter-btn" type="button">
         <i class="bi bi-funnel"></i>
         Filters
       </button>
       <form method="GET" action="/courses" class="mb-3 filter-area d-none">
         <div class="d-flex flex-column g-2 align-items-start">
           <div class="col-sm-3 col-md-3">
             <label for="courseSearch" class="form-label small text-muted">Search</label>
             <input type="text" class="form-control form-control-sm" id="courseSearch" name="q" placeholder="Search by code or name..." value="<%= typeof q !== 'undefined' ? q : '' %>">
           </div>
           <div class="col-sm-3 col-md-3">
             <label for="handoutFilter" class="form-label small text-muted">Handout</label>
             <select class="form-select form-select-sm" id="handoutFilter" name="handout">
               <option value="all" <%= (typeof handout === 'undefined' || handout === 'all') ? 'selected' : '' %>>All</option>
               <option value="with" <%= typeof handout !== 'undefined' && handout === 'with' ? 'selected' : '' %>>With Handout</option>
               <option value="without" <%= typeof handout !== 'undefined' && handout === 'without' ? 'selected' : '' %>>Without Handout</option>
             </select>
           </div>
           <div class="col-sm-2 mt-3">
              <div class="d-flex gap-2">
                <a href="/courses" class="btn btn-outline-secondary btn-sm w-100">
                  <i class="bi bi-x-lg"></i>
                  <span>Reset</span>
                </a>
                <button type="submit" class="btn btn-primary btn-sm w-100">
                  <i class="bi bi-check-lg"></i>
                  <span>Apply</span>
                </button>
              </div>~
           </div>
         </div>
       </form>
      </div>
    </div>

  <% if (typeof courses !== 'undefined' && courses.length > 0) { %>
  <table class="table table-hover align-middle">
    <thead>
      <tr class="sticky-table-header">
        <th>Course Code</th>
        <th>Course Name</th>
        <th class="text-center">Downloads</th>
        <th>Handout</th>
        <th>Created</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% courses.forEach(function(c) { %>
      <tr>
        <td>
          <a href="/courses/<%= c.courseId %>" class="text-decoration-none fw-medium" title="View <%= c.courseCode %> course">
            <span class="fw-semibold"><%= c.courseCode %></span>
          </a>
        </td>
        <td>
          <a href="/courses/<%= c.courseId %>" class="text-decoration-none fw-medium" title="View <%= c.courseCode %> course">
            <%= c.courseName %>
          </a>
        </td>
        <td class="text-center"><%= c.downloadCount || 0 %></td>
        <td>
          <% if (c.handoutOriginalFilename) { %>
          <span class="text-muted small"><%= c.handoutOriginalFilename %></span>
          <% } else { %>
          <span class="text-muted">-</span>
          <% } %>
        </td>
        <td class="text-muted small"><%= c.createdAt ? new Date(c.createdAt).toLocaleDateString() : '-' %></td>
        <td class="text-end">
          <a href="/courses/<%= c.courseId %>/edit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-list-check"></i>
          </a>
          <form action="/courses/<%= c.courseId %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete <%= c.courseCode %>? This will also delete related quizzes, questions, and content.')">
            <button type="submit" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- Pagination -->
  <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
  <nav>
    <ul class="pagination justify-content-center">
      <% const qs = []; if (typeof q !== 'undefined' && q) qs.push('q=' + encodeURIComponent(q)); if (typeof handout !== 'undefined' && handout) qs.push('handout=' + encodeURIComponent(handout)); const qsStr = qs.length ? '&' + qs.join('&') : ''; %>
      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page - 1 %><%= qsStr %>">Previous</a>
      </li>
      <li class="page-item disabled">
        <span class="page-link">Page <%= pagination.page %> of <%= pagination.pages %></span>
      </li>
      <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page + 1 %><%= qsStr %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
  <% } else { %>
  <div class="text-center py-5">
    <i class="bi bi-journal-bookmark display-1 text-muted mb-3"></i>
    <h5 class="text-muted">No courses found</h5>
    <a href="/courses/new" class="btn btn-primary mt-2">
      <i class="bi bi-plus-lg"></i> Add your first course
    </a>
  </div>
  <% } %>
</div>
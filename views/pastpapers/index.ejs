<!-- pastpapers/index.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Past Papers</h1>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary"><%= total || 0 %> papers</span>
      <a href="/pastpapers/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg"></i> Add Past Paper
      </a>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <!-- Search & Filter -->
  <div class="row">
    <div class="col-12">
      <button class="btn btn-outline-secondary my-3 filter-btn" type="button">
        <i class="bi bi-funnel"></i>
        Filters
      </button>
      <form method="GET" action="/pastpapers" class="mb-3 filter-area d-none">
        <div class="d-flex flex-column g-2 align-items-start">
          <div class="col-sm-3 col-md-3">
            <label for="paperSearch" class="form-label small text-muted">Search</label>
            <input type="text" class="form-control form-control-sm" id="paperSearch" name="q" placeholder="Search by course or year..." value="<%= typeof q !== 'undefined' ? q : '' %>">
          </div>
          <div class="col-sm-3 col-md-3">
            <label for="typeFilter" class="form-label small text-muted">Type</label>
            <select class="form-select form-select-sm" id="typeFilter" name="type">
              <option value="all" <%= (typeof type === 'undefined' || type === 'all') ? 'selected' : '' %>>All</option>
              <option value="midterm" <%= typeof type !== 'undefined' && type === 'midterm' ? 'selected' : '' %>>Mid Term</option>
              <option value="finalterm" <%= typeof type !== 'undefined' && type === 'finalterm' ? 'selected' : '' %>>Final Term</option>
            </select>
          </div>
          <div class="col-sm-3 col-md-3">
            <label for="semesterFilter" class="form-label small text-muted">Semester</label>
            <select class="form-select form-select-sm" id="semesterFilter" name="semester">
              <option value="all" <%= (typeof semester === 'undefined' || semester === 'all') ? 'selected' : '' %>>All</option>
              <option value="spring" <%= typeof semester !== 'undefined' && semester === 'spring' ? 'selected' : '' %>>Spring</option>
              <option value="fall" <%= typeof semester !== 'undefined' && semester === 'fall' ? 'selected' : '' %>>Fall</option>
            </select>
          </div>
          <div class="col-sm-3 col-md-3">
            <label for="statusFilter" class="form-label small text-muted">Status</label>
            <select class="form-select form-select-sm" id="statusFilter" name="status">
              <option value="all" <%= (typeof status === 'undefined' || status === 'all') ? 'selected' : '' %>>All</option>
              <option value="draft" <%= typeof status !== 'undefined' && status === 'draft' ? 'selected' : '' %>>Draft</option>
              <option value="publish" <%= typeof status !== 'undefined' && status === 'publish' ? 'selected' : '' %>>Published</option>
              <option value="pending" <%= typeof status !== 'undefined' && status === 'pending' ? 'selected' : '' %>>Pending</option>
            </select>
          </div>
          <div class="col-sm-2 mt-3">
            <div class="d-flex gap-2">
              <a href="/pastpapers" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-lg"></i>
                <span>Reset</span>
              </a>
              <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-check-lg"></i>
                <span>Apply</span>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <% if (typeof papers !== 'undefined' && papers.length > 0) { %>
  <table class="table table-hover align-middle">
    <thead>
      <tr class="sticky-table-header">
        <th>Title</th>
        <th>Course</th>
        <th>Year</th>
        <th>Type</th>
        <th>Semester</th>
        <th>Status</th>
        <th>File</th>
        <th>Created</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% papers.forEach(function(p) { %>
      <tr>
        <td>
          <a href="/pastpapers/<%= p.id %>" class="text-decoration-none fw-medium" title="View <%= p.courseCode || '-' %> <%= p.type || '-' %> <%= p.year || '-' %>">
            <%= p.courseCode || '-' %>
            <%= p.type || '-' %>
            <%= p.year || '-' %>
          </a>
        </td>
        <td>
          <a href="/courses/<%= p.courseId %>" class="text-decoration-none fw-medium" title="View <%= p.courseCode %> course">
            <span class="fw-semibold"><%= p.courseCode %></span>
          </a>
          <a href="/courses/<%= p.courseId %>" class="text-decoration-none fw-medium" title="View <%= p.courseCode %> course">
            <small class="d-block text-muted"><%= p.courseName %></small>
          </a>
        </td>
        <td><%= p.year || '-' %></td>
        <td><%= p.type || '-' %></td>
        <td><%= p.semester || '-' %></td>
        <td>
          <span class="badge bg-<%= p.status === 'publish' ? 'success' : (p.status === 'draft' ? 'secondary' : 'warning') %>">
            <%= p.status %>
          </span>
        </td>
        <td>
          <% if (p.filePath) { %>
          <a href="<%= p.filePath %>" target="_blank" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-file-earmark-pdf"></i>
          </a>
          <% } else { %>
          <span class="text-muted">-</span>
          <% } %>
        </td>
        <td class="text-muted small"><%= p.createdAt ? new Date(p.createdAt).toLocaleDateString() : '-' %></td>
        <td class="text-end">
          <a href="/pastpapers/<%= p.id %>/edit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-list-check"></i>
          </a>
          <form action="/pastpapers/<%= p.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this past paper?')">
            <button type="submit" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- Pagination -->
  <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
  <% const qs = []; if (typeof q !== 'undefined' && q) qs.push('q=' + encodeURIComponent(q)); if (typeof type !== 'undefined' && type && type !== 'all') qs.push('type=' + encodeURIComponent(type)); if (typeof semester !== 'undefined' && semester && semester !== 'all') qs.push('semester=' + encodeURIComponent(semester)); if (typeof status !== 'undefined' && status && status !== 'all') qs.push('status=' + encodeURIComponent(status)); const qsStr = qs.length ? '&' + qs.join('&') : ''; %>
  <nav>
    <ul class="pagination justify-content-center">
      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page - 1 %><%= qsStr %>">Previous</a>
      </li>
      <li class="page-item disabled">
        <span class="page-link">Page <%= pagination.page %> of <%= pagination.pages %></span>
      </li>
      <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page + 1 %><%= qsStr %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
  <% } else { %>
  <div class="text-center py-5">
    <i class="bi bi-file-earmark-pdf display-1 text-muted mb-3"></i>
    <h5 class="text-muted">No past papers found</h5>
    <a href="/pastpapers/new" class="btn btn-primary mt-2">
      <i class="bi bi-plus-lg"></i> Add your first past paper
    </a>
  </div>
  <% } %>
</div>
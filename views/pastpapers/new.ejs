<!-- pastpapers/new.ejs -->
<div class="container py-4" data-controller="pastpaper" data-action="new">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <a href="/pastpapers" class="btn btn-light btn-sm rounded-circle p-2 lh-1">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 fw-bold mb-1">Upload Past Paper</h1>
                    <p class="text-muted small mb-0">Share a past exam paper with the community</p>
                </div>
            </div>

            <!-- Form -->
            <form data-target="pastpaper.form" class="needs-validation" novalidate>
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold mb-3">Paper Details</h6>

                        <!-- Course (searchable combobox) -->
                        <div class="mb-3">
                            <label for="courseSearch" class="form-label small fw-medium">Course <span
                                    class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="text" class="form-control" id="courseSearch"
                                    data-target="pastpaper.courseSearch"
                                    data-action="input->pastpaper#searchCourse blur->pastpaper#blurCourseSearch"
                                    placeholder="Search by course code or name..." autocomplete="off" required>
                                <input type="hidden" data-target="pastpaper.courseId" name="courseId" value="">
                                <div class="invalid-feedback">Please select a course.</div>
                                <!-- Dropdown results -->
                                <div data-target="pastpaper.courseResults"
                                    class="list-group position-absolute w-100 shadow-sm"
                                    style="display: none; z-index: 1000; max-height: 250px; overflow-y: auto; border-radius: 0 0 8px 8px;">
                                </div>
                            </div>
                            <div class="form-text">Type course code in the search field to select course.</div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <!-- Type -->
                                <div class="mb-3">
                                    <label for="type" class="form-label small fw-medium">Type</label>
                                    <select class="form-select" id="type" data-target="pastpaper.typeSelect">
                                        <option value="">Select type...</option>
                                        <option value="midterm">Mid Term</option>
                                        <option value="finalterm">Final Term</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <!-- Semester -->
                                <div class="mb-3">
                                    <label for="semester" class="form-label small fw-medium">Semester</label>
                                    <select class="form-select" id="semester" data-target="pastpaper.semesterSelect">
                                        <option value="">Select semester...</option>
                                        <option value="spring">Spring</option>
                                        <option value="fall">Fall</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <!-- Year -->
                                <div class="mb-3">
                                    <label for="year" class="form-label small fw-medium">Year <span
                                            class="text-danger">*</span></label>
                                    <select class="form-select" id="year" data-target="pastpaper.yearSelect" required>
                                        <option value="">Select year...</option>
                                        <% const currentYear=new Date().getFullYear(); %>
                                            <% for (let y=currentYear; y>= 2020; y--) { %>
                                                <option value="<%= y %>">
                                                    <%= y %>
                                                </option>
                                                <% } %>
                                    </select>
                                    <div class="invalid-feedback">Please select a year.</div>
                                </div>
                            </div>
                        </div>
                        <!-- Status -->
                        <div class="form-check">
                            <label for="status" class="form-check-label small fw-medium me-2">Save as Draft </label>
                            <input type="checkbox" id="status" data-target="pastpaper.status" class="form-check-input">
                        </div>
                    </div>
                </div>

                <!-- File Upload -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h6 class="fw-semibold mb-3">PDF File</h6>

                        <div class="mb-3">
                            <label for="file" class="form-label small fw-medium">PDF File <span
                                    class="text-danger">*</span></label>
                            <input type="file" class="form-control" id="file" data-target="pastpaper.file"
                                accept="application/pdf" required>
                            <div class="form-text">Maximum file size: 20MB. Only PDF files are accepted.</div>
                            <div class="invalid-feedback">Please select a PDF file.</div>
                        </div>

                        <!-- Upload progress -->
                        <div data-target="pastpaper.uploadProgress" class="mb-3" style="display: none;">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Uploading to Google Drive...</span>
                                <span data-target="pastpaper.uploadPercent">0%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated"
                                    data-target="pastpaper.uploadBar" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary px-4" data-target="pastpaper.submitBtn"
                        data-action="click->pastpaper#create">
                        <i class="bi bi-cloud-upload me-1"></i> Upload Paper
                    </button>
                    <a href="/pastpapers" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- pastpapers/edit.ejs -->
<div class="container py-4" data-controller="pastpaper" data-action="edit">
    <input type="hidden" data-target="pastpaper.paperId" value="<%= id %>">

    <!-- Loading skeleton -->
    <div data-target="pastpaper.loading" style="display: block;">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="skeleton-line mb-3" style="width: 50px; height: 36px;"></div>
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="skeleton-line mb-3" style="width: 40%; height: 24px;"></div>
                        <div class="skeleton-line mb-2" style="width: 100%; height: 38px;"></div>
                        <div class="skeleton-line mb-2" style="width: 100%; height: 38px;"></div>
                        <div class="skeleton-line mb-2" style="width: 100%; height: 38px;"></div>
                        <div class="skeleton-line" style="width: 100%; height: 38px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div data-target="pastpaper.content" style="display: none;">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Header -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <a href="/pastpapers" class="btn btn-light btn-sm rounded-circle p-2 lh-1">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h1 class="h3 fw-bold mb-1">Edit Past Paper</h1>
                        <p class="text-muted small mb-0">Update the details of this past paper</p>
                    </div>
                </div>

                <!-- Form -->
                <form data-target="pastpaper.editForm" class="needs-validation" novalidate>
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h6 class="fw-semibold mb-3">Paper Details</h6>

                            <!-- Course (searchable combobox) -->
                            <div class="mb-3">
                                <label for="editCourseSearch" class="form-label small fw-medium">Course <span
                                        class="text-danger">*</span></label>
                                <div class="position-relative">
                                    <input type="text" class="form-control" id="editCourseSearch"
                                        data-target="pastpaper.editCourseSearch"
                                        data-action="input->pastpaper#searchEditCourse blur->pastpaper#blurEditCourseSearch"
                                        placeholder="Search by course code or name..." autocomplete="off" required>
                                    <input type="hidden" data-target="pastpaper.editCourseId" name="courseId" value="">
                                    <div class="invalid-feedback">Please select a course.</div>
                                    <!-- Dropdown results -->
                                    <div data-target="pastpaper.editCourseResults"
                                        class="list-group position-absolute w-100 shadow-sm"
                                        style="display: none; z-index: 1000; max-height: 250px; overflow-y: auto; border-radius: 0 0 8px 8px;">
                                    </div>
                                </div>
                                <div class="form-text">Type course code in the search field to select course.</div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <!-- Type -->
                                    <div class="mb-3">
                                        <label for="editType" class="form-label small fw-medium">Type <span
                                                class="text-danger">*</span></label>
                                        <select class="form-select" id="editType" data-target="pastpaper.editType"
                                            required>
                                            <option value="">Select type...</option>
                                            <option value="midterm">Mid Term</option>
                                            <option value="finalterm">Final Term</option>
                                        </select>
                                        <div class="invalid-feedback">Please select a type.</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <!-- Semester -->
                                    <div class="mb-3">
                                        <label for="editSemester" class="form-label small fw-medium">Semester <span
                                                class="text-danger">*</span></label>
                                        <select class="form-select" id="editSemester"
                                            data-target="pastpaper.editSemester" required>
                                            <option value="">Select semester...</option>
                                            <option value="spring">Spring</option>
                                            <option value="fall">Fall</option>
                                        </select>
                                        <div class="invalid-feedback">Please select a semester.</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <!-- Year -->
                                    <div class="mb-3">
                                        <label for="editYear" class="form-label small fw-medium">Year <span
                                                class="text-danger">*</span></label>
                                        <select class="form-select" id="editYear" data-target="pastpaper.editYear"
                                            required>
                                            <option value="">Select year...</option>
                                            <% const currentYear=new Date().getFullYear(); %>
                                                <% for (let y=currentYear; y>= 2020; y--) { %>
                                                    <option value="<%= y %>">
                                                        <%= y %>
                                                    </option>
                                                    <% } %>
                                        </select>
                                        <div class="invalid-feedback">Please select a year.</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="mb-3">
                                <label for="editStatus" class="form-label small fw-medium me-2">Save as Draft </label>
                                <input type="checkbox" id="editStatus" data-target="pastpaper.editStatus" class="form-input">
                            </div>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary px-4" data-target="pastpaper.updateBtn"
                            data-action="click->pastpaper#update">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                        <a href="/pastpapers" class="btn btn-outline-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Error state -->
    <div data-target="pastpaper.error" class="text-center py-5" style="display: none;">
        <i class="bi bi-exclamation-triangle display-4 text-warning mb-3 d-block"></i>
        <h5 class="text-muted">Failed to load past paper</h5>
        <p class="text-muted small mb-3" data-target="pastpaper.errorMessage"></p>
        <a href="/pastpapers" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i> Back to Past Papers
        </a>
    </div>
</div>
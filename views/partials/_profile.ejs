<li class="nav-item">
  <div class="dropdown ms-auto d-md-block d-none">
    <button class="btn btn-sm btn-outline-light border-0 outline-0 rounded-circle ms-1 text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      <% if(user.role == 'admin' && user.avatar) { %>
      <img src="<%= user.avatar %>" class="rounded-circle" style="width: 40px; height: auto; object-fit: cover;" />
      <% } else { %>
      <span class="btn btn-primary rounded-circle me-2" style="width: 40px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
        <%= user.name[0].toUpperCase() %>
      </span>
      <% } %>
    </button>
    <ul class="dropdown-menu">
      <li class="dropdown-item">
        <span class="text-truncate" style="max-width: 180px; display: inline-block; vertical-align: middle;">
          <%= user.name %>
        </span>
      </li>
      <li class="dropdown-item">
        <form action="/api/auth/logout?_method=DELETE" method="POST" class="d-inline">
          <button type="submit" onclick="return confirm('Are you sure to logout?')" class="btn p-0 border-0 outline-0 text-danger">
            <i class="bi bi-box-arrow-right me-2"></i> Logout
          </button>
        </form>
      </li>
    </ul>
  </div>
</li>
<div class="mt-auto border-top pt-2 sidebar-link">
        <% if(user.role == 'admin' && user.avatar) { %>
            <img src="<%= user.avatar %>" class="rounded-circle" style="width: 40px; height: auto; object-fit: cover;" />
        <% } else { %>
            <span class="btn btn-primary rounded-circle me-2"
                style="width: 40px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
                <%= user.name[0].toUpperCase() %>
            </span>
        <% } %>

        <span class="text-truncate" style="max-width: 130px; display: inline-block; vertical-align: middle;">
            <%= user.name %>
        </span>
        <div class="dropdown ms-auto">
            <button class="btn btn-sm btn-outline-light border-0 outline-0 rounded-circle ms-1 text-dark" type="button"
                data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu">
                <li class="dropdown-item">
                    <form action="/api/auth/logout?_method=DELETE" method="POST" class="d-inline">
                      <button type="submit" onclick="return confirm('Are you sure to logout?')" class="btn p-0 border-0 outline-0 text-danger w-100">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                      </button>
                    </form>
                </li>
            </ul>
        </div>
</div>
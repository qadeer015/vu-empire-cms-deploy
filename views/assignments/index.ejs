<!-- assignments/index.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Assignments</h1>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary"><%= total || 0 %> assignments</span>
      <a href="/assignments/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg"></i> Add Assignment
      </a>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <!-- Search & Filter -->
  <div class="row">
    <div class="col-12">
      <button class="btn btn-outline-secondary my-3 filter-btn" type="button">
        <i class="bi bi-funnel"></i>
        Filters
      </button>
      <form method="GET" action="/assignments" class="mb-3 filter-area d-none">
        <div class="d-flex flex-column g-2 align-items-start">
          <div class="col-sm-3 col-md-3">
            <label for="assignmentSearch" class="form-label small text-muted">Search</label>
            <input type="text" class="form-control form-control-sm" id="assignmentSearch" name="q" placeholder="Search by title or course..." value="<%= typeof q !== 'undefined' ? q : '' %>">
          </div>
          <div class="col-sm-3 col-md-3">
            <label for="statusFilter" class="form-label small text-muted">Status</label>
            <select class="form-select form-select-sm" id="statusFilter" name="status">
              <option value="all" <%= (typeof status === 'undefined' || status === 'all') ? 'selected' : '' %>>All</option>
              <option value="draft" <%= typeof status !== 'undefined' && status === 'draft' ? 'selected' : '' %>>Draft</option>
              <option value="publish" <%= typeof status !== 'undefined' && status === 'publish' ? 'selected' : '' %>>Published</option>
              <option value="pending" <%= typeof status !== 'undefined' && status === 'pending' ? 'selected' : '' %>>Pending</option>
            </select>
          </div>
          <div class="col-sm-3 col-md-3">
            <label for="dueDateFilter" class="form-label small text-muted">Due Date</label>
            <input type="date" class="form-control form-control-sm" id="dueDateFilter" name="dueDate" value="<%= typeof dueDate !== 'undefined' && dueDate !== 'all' ? dueDate : '' %>">
          </div>
          <div class="col-sm-2 mt-3">
            <div class="d-flex gap-2">
              <a href="/assignments" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-lg"></i>
                <span>Reset</span>
              </a>
              <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-check-lg"></i>
                <span>Apply</span>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <% if (typeof assignments !== 'undefined' && assignments.length > 0) { %>
  <table class="table table-hover align-middle">
    <thead>
      <tr class="sticky-table-header">
        <th>Title</th>
        <th>Course</th>
        <th>Due Date</th>
        <th>Status</th>
        <th>Created</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% assignments.forEach(function(a) { %>
      <tr>
        <td>
          <a href="/assignments/<%= a.id %>" class="text-decoration-none fw-medium" title="View <%= a.title %>">
            <%= a.title %>
          </a>
        </td>
        <td>
          <a href="/courses/<%= a.courseId %>" class="text-decoration-none fw-medium" title="View <%= a.courseCode %> course">
            <span class="fw-semibold"><%= a.courseCode %></span>
          </a>
          <a href="/courses/<%= a.courseId %>" class="text-decoration-none fw-medium" title="View <%= a.courseCode %> course">
            <small class="d-block text-muted"><%= a.courseName %></small>
          </a>
        </td>
        <td class="text-muted small"><%= a.dueDate ? new Date(a.dueDate).toLocaleDateString() : '-' %></td>
        <td>
          <span class="badge bg-<%= a.status === 'publish' ? 'success' : (a.status === 'draft' ? 'secondary' : 'warning') %>">
            <%= a.status %>
          </span>
        </td>
        <td class="text-muted small"><%= a.createdAt ? new Date(a.createdAt).toLocaleDateString() : '-' %></td>
        <td class="text-end">
          <a href="/assignments/<%= a.id %>/edit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-list-check"></i>
          </a>
          <form action="/assignments/<%= a.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this assignment?')">
            <button type="submit" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- Pagination -->
  <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
  <% const qs = []; if (typeof q !== 'undefined' && q) qs.push('q=' + encodeURIComponent(q)); if (typeof status !== 'undefined' && status && status !== 'all') qs.push('status=' + encodeURIComponent(status)); if (typeof dueDate !== 'undefined' && dueDate && dueDate !== 'all') qs.push('dueDate=' + encodeURIComponent(dueDate)); const qsStr = qs.length ? '&' + qs.join('&') : ''; %>
  <nav>
    <ul class="pagination justify-content-center">
      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page - 1 %><%= qsStr %>">Previous</a>
      </li>
      <li class="page-item disabled">
        <span class="page-link">Page <%= pagination.page %> of <%= pagination.pages %></span>
      </li>
      <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page + 1 %><%= qsStr %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
  <% } else { %>
  <div class="text-center py-5">
    <i class="bi bi-pencil-square display-1 text-muted mb-3"></i>
    <h5 class="text-muted">No assignments found</h5>
    <a href="/assignments/new" class="btn btn-primary mt-2">
      <i class="bi bi-plus-lg"></i> Add your first assignment
    </a>
  </div>
  <% } %>
</div>
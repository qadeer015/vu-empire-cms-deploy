<%
    // Pick the right big visual based on status code / type.
    // Use distinct local names to avoid shadowing the values passed in
    // by res.render() (which would cause a TDZ / "Cannot access X before
    // initialization" error inside the typeof guards below).
    const _isNotFound = (typeof isNotFound !== 'undefined' && isNotFound)
        || (typeof statusCode !== 'undefined' && statusCode === 404)
        || (typeof title !== 'undefined' && title === 'Page Not Found');
    const _isServerError = (typeof isServerError !== 'undefined' && isServerError)
        || (typeof statusCode !== 'undefined' && statusCode >= 500);
    const _showStack = (typeof showDetails !== 'undefined' && showDetails) && error;
%>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="text-center">
                <div class="display-1 fw-bold mb-4 <%= _isNotFound ? 'text-primary' : (_isServerError ? 'text-danger' : 'text-warning') %>">
                    <% if (_isNotFound) { %>
                        404
                    <% } else if (_isServerError) { %>
                        <i class="bi bi-exclamation-triangle"></i>
                    <% } else { %>
                        <i class="bi bi-exclamation-circle"></i>
                    <% } %>
                </div>
                <h1 class="mb-3">
                    <%= title || (_isNotFound ? 'Page Not Found' : (_isServerError ? 'Server Error' : 'Error')) %>
                </h1>
                <p class="lead mb-4">
                    <%= message || (_isNotFound
                        ? 'The page or resource you are looking for does not exist.'
                        : (_isServerError ? 'Something went wrong on our end.' : 'Your request could not be processed.')) %>
                </p>

                <% if (typeof type !== 'undefined' && type === 'not_found' && resourceType) { %>
                    <p class="small text-muted">
                        Resource type: <code><%= resourceType %></code>
                    </p>
                <% } %>

                <% if (_showStack) { %>
                    <div class="alert alert-light border text-start mb-4" role="alert">
                        <small class="text-muted d-block mb-1">Error details (development):</small>
                        <pre class="mb-0 small text-break" style="white-space: pre-wrap; max-height: 240px; overflow: auto;"><%= error %></pre>
                    </div>
                <% } %>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a href="<%= redirect_url || '/' %>" class="btn btn-primary">
                        <i class="bi bi-arrow-left me-2"></i>
                        <%= _isNotFound ? 'Back to Home' : 'Go Back' %>
                    </a>
                    <% if (!_isNotFound) { %>
                        <a href="/" class="btn btn-outline-secondary">
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- quizzes/questions/_form.ejs -->
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><%= mode === 'new' ? 'Add Question' : 'Edit Question' %></h1>
    </div>
    <%- include('../../partials/_breadcrumb') %>

    <% if (quiz && quiz.title === 'Main') { %>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Bulk Upload Questions (JSON)</h5>
            <form action="/quizzes/<%= quiz.quizId %>/questions/bulk" method="POST" enctype="multipart/form-data" id="bulkUploadForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Upload JSON File</label>
                        <input type="file" name="questionsFile" accept=".json" class="form-control" required id="questionsFileInput">
                        <div class="form-text">
                            Expected format: { "questions": [ { "questionText": "...", "options": ["A", "B", "C", "D"], "explanation": "..." } ] }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-secondary w-100 mb-2" id="downloadTemplateBtn">
                            <i class="bi bi-download"></i> Download Template
                        </button>
                        <button type="submit" class="btn btn-success w-100" id="uploadBtn">
                            <i class="bi bi-upload"></i> Upload & Create Questions
                        </button>
                    </div>
                </div>
            </form>

            <!-- Preview Section -->
            <div id="previewSection" class="mt-4" style="display: none;">
                <hr>
                <h6 class="fw-bold">File Preview</h6>
                <div class="alert alert-info">
                    <div id="previewStats"></div>
                </div>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Question Text</th>
                                <th style="width: 100px;">Options</th>
                                <th style="width: 100px;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="previewTableBody"></tbody>
                    </table>
                </div>
            </div>
            <!-- Upload Progress -->
            <div id="uploadProgress" class="mt-3" style="display: none;">
                <div class="d-flex justify-content-between mb-1">
                    <span class="form-label fw-bold">Uploading file...</span>
                    <span id="progressText">0%</span>
                </div>
                <div class="progress" style="height: 20px;">
                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                </div>
            </div>

            <!-- Processing Indicator -->
            <div id="processingIndicator" class="mt-3" style="display: none;">
                <div class="alert alert-info d-flex align-items-center">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Processing questions... Please wait.</span>
                </div>
            </div>

            <!-- Results Section -->
            <div id="resultsSection" class="mt-4" style="display: none;">
                <hr>
                <h6 class="fw-bold">Upload Results</h6>
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                            <div class="card-body text-center">
                                <h3 class="mb-0 text-success" id="createdCount">0</h3>
                                <small class="text-muted">Created</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
                            <div class="card-body text-center">
                                <h3 class="mb-0 text-warning" id="skippedCount">0</h3>
                                <small class="text-muted">Skipped</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm bg-danger bg-opacity-10">
                            <div class="card-body text-center">
                                <h3 class="mb-0 text-danger" id="errorCount">0</h3>
                                <small class="text-muted">Errors</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm bg-info bg-opacity-10">
                            <div class="card-body text-center">
                                <h3 class="mb-0 text-info" id="totalCount">0</h3>
                                <small class="text-muted">Total</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Skipped Questions Table -->
                <div id="skippedQuestionsSection" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                        <h6 class="fw-bold mb-0">Skipped / Failed Questions</h6>
                        <button type="button" class="btn btn-sm btn-primary" id="createAllSkippedBtn">
                            <i class="bi bi-plus-lg"></i> Create All Skipped
                        </button>
                    </div>
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Question Text</th>
                                    <th>Reason</th>
                                    <th style="width: 120px;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="skippedTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <hr>
    <% } %>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <% if (mode === 'edit' && question) { %>
                <form action="/questions/<%= question.questionId %>" method="POST">
            <% } else { %>
                <form action="/quizzes/<%= quiz.quizId %>/questions" method="POST">
            <% } %>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Course</label>
                        <select name="courseId" class="form-select">
                            <% courses.forEach(function(c) { %>
                            <option value="<%= c.courseId %>" <%= question && question.courseId == c.courseId ? 'selected' : (quiz && quiz.courseId == c.courseId ? 'selected' : '') %>>
                                <%= c.courseCode %> - <%= c.courseName %>
                            </option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Quiz</label>
                        <input type="text" class="form-control" value="<%= quiz ? quiz.title : '' %>" disabled>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Question Text <span class="text-danger">*</span></label>
                    <textarea class="form-control" name="questionText" rows="3" required
                              placeholder="Enter the question text..."><%= question ? question.questionText : '' %></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Explanation (optional)</label>
                    <textarea class="form-control" name="explanation" rows="2"
                              placeholder="Explanation for the correct answer..."><%= question ? question.explanation : '' %></textarea>
                </div>

                <h5 class="mb-3">Options</h5>
                <div id="optionsContainer">
                    <% const existingOptions = question && question.options ? (Array.isArray(question.options) ? question.options : []) : []; %>
                    <%
                    const optionCount = Math.max(existingOptions.length, 4);
                    for (let i = 0; i < optionCount; i++) { 
                        const opt = existingOptions[i] || null;
                        const letter = opt ? opt.letter : String.fromCharCode(65 + i);
                        const isCorrect = opt ? opt.isCorrect === 1 || opt.isCorrect === true : false;
                    %>
                    <div class="row g-2 mb-2 option-row">
                        <div class="col-auto d-flex align-items-center">
                            <span class="badge bg-secondary option-letter"><%= letter %></span>
                        </div>
                        <div class="col">
                            <input type="text" class="form-control" name="options[<%= i %>][text]" 
                                   value="<%= opt ? opt.optionText : '' %>" placeholder="Option <%= letter %> text">
                            <input type="hidden" name="options[<%= i %>][letter]" value="<%= letter %>">
                        </div>
                        <div class="col-auto d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="options[<%= i %>][isCorrect]" 
                                       value="on" id="correct<%= i %>" <%= isCorrect ? 'checked' : '' %>>
                                <label class="form-check-label small" for="correct<%= i %>">Correct</label>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>

                <div class="mt-3 mb-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addOptionRow()">
                        <i class="bi bi-plus-lg"></i> Add Option
                    </button>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> <%= mode === 'new' ? 'Create Question' : 'Update Question' %>
                    </button>
                    <a href="/quizzes/<%= quiz ? quiz.quizId : '' %>/edit" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let optionRowCount = <%= Math.max(existingOptions ? existingOptions.length : 0, 4) %>;

    function addOptionRow() {
        const container = document.getElementById('optionsContainer');
        const letter = String.fromCharCode(65 + optionRowCount);
        const row = document.createElement('div');
        row.className = 'row g-2 mb-2 option-row';
        row.innerHTML = `
            <div class="col-auto d-flex align-items-center">
                <span class="badge bg-secondary option-letter">${letter}</span>
            </div>
            <div class="col">
                <input type="text" class="form-control" name="options[${optionRowCount}][text]" placeholder="Option ${letter} text">
                <input type="hidden" name="options[${optionRowCount}][letter]" value="${letter}">
            </div>
            <div class="col-auto d-flex align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="options[${optionRowCount}][isCorrect]" value="on" id="correct${optionRowCount}">
                    <label class="form-check-label small" for="correct${optionRowCount}">Correct</label>
                </div>
            </div>
        `;
        container.appendChild(row);
        optionRowCount++;
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    async function handleFileSelect(event) {
        const file = event.target.files[0];
        const previewSection = document.getElementById('previewSection');
        const previewStats = document.getElementById('previewStats');
        const previewTableBody = document.getElementById('previewTableBody');
        
        if (!file) {
            previewSection.style.display = 'none';
            return;
        }

        // Use server-side preview to check for duplicates against DB
        const formData = new FormData();
        formData.append('questionsFile', file);

        try {
            previewStats.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Analyzing file...';
            previewSection.style.display = 'block';
            previewTableBody.innerHTML = '';

            const response = await fetch('/quizzes/<%= quiz.quizId %>/questions/preview', {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
            });

            const contentType = response.headers.get('content-type') || '';
            let data;

            if (!response.ok || !contentType.includes('application/json')) {
                const text = await response.text();
                let errorMsg = 'Preview failed (status: ' + response.status + ')';
                const trimmed = (text || '').trim();
                if (trimmed.startsWith('<!') || trimmed.startsWith('<html')) {
                    errorMsg = 'Session expired or access denied. Please refresh and log in again.';
                } else if (trimmed) {
                    errorMsg = errorMsg + ': ' + trimmed.substring(0, 120);
                }
                previewStats.innerHTML = `<strong>Error:</strong> ${errorMsg}`;
                return;
            }

            data = await response.json();

            if (!data.success) {
                previewStats.innerHTML = `<strong>Error:</strong> ${data.message || 'Unknown error'}`;
                return;
            }

            const { summary, preview } = data;
            
            let statsHtml = `<strong>Total questions in file:</strong> ${summary.total}<br>`;
            statsHtml += `<strong class="text-success">Ready to create:</strong> ${summary.valid}<br>`;
            if (summary.invalid > 0) {
                statsHtml += `<strong class="text-danger">Invalid questions:</strong> ${summary.invalid}<br>`;
            }
            if (summary.duplicateInFile > 0) {
                statsHtml += `<strong class="text-warning">Duplicates within file:</strong> ${summary.duplicateInFile}<br>`;
            }
            if (summary.duplicateInDb > 0) {
                statsHtml += `<strong class="text-warning">Already in database:</strong> ${summary.duplicateInDb}<br>`;
            }
            statsHtml += `<small class="text-muted">Invalid and duplicate questions will be skipped during upload.</small>`;
            
            previewStats.innerHTML = statsHtml;

            // Build preview table (show all, with scroll)
            const previewLimit = 200;
            const questionsToShow = preview.slice(0, previewLimit);
            
            let tableHtml = '';
            questionsToShow.forEach(q => {
                let statusBadge = '';
                switch(q.status) {
                    case 'ready':
                        statusBadge = '<span class="badge bg-success">Ready</span>';
                        break;
                    case 'invalid':
                        statusBadge = '<span class="badge bg-danger">Invalid</span>';
                        break;
                    case 'duplicate_in_file':
                        statusBadge = '<span class="badge bg-warning text-dark">Duplicate in file</span>';
                        break;
                    case 'duplicate_in_db':
                        statusBadge = '<span class="badge bg-warning text-dark">In database</span>';
                        break;
                    default:
                        statusBadge = '<span class="badge bg-secondary">Unknown</span>';
                }
                
                const questionText = q.questionText ? q.questionText.substring(0, 80) + (q.questionText.length > 80 ? '...' : '') : 'N/A';
                const optionsCount = q.options && Array.isArray(q.options) ? q.options.length : 0;
                
                tableHtml += `
                    <tr>
                        <td>${q.originalIndex}</td>
                        <td>${escapeHtml(questionText)}</td>
                        <td>${optionsCount} options</td>
                        <td>${statusBadge}</td>
                    </tr>
                `;
            });

            if (preview.length > previewLimit) {
                tableHtml += `
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            ... and ${preview.length - previewLimit} more questions
                        </td>
                    </tr>
                `;
            }

            previewTableBody.innerHTML = tableHtml;

        } catch (err) {
            previewStats.innerHTML = `<strong>Error analyzing file:</strong> ${err.message}`;
            previewTableBody.innerHTML = '';
        }
    }

    // Download JSON template
    document.getElementById('downloadTemplateBtn').addEventListener('click', function() {
        const template = {
            questions: [
                {
                    questionText: "What is the capital of France?",
                    options: ["Paris", "London", "Berlin", "Madrid"],
                    explanation: "Paris is the capital and largest city of France."
                },
                {
                    questionText: "What is 2 + 2?",
                    options: ["3", "4", "5", "6"],
                    explanation: "2 + 2 equals 4."
                }
            ]
        };
        
        const blob = new Blob([JSON.stringify(template, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'questions-template.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    });

    document.getElementById('questionsFileInput').addEventListener('change', handleFileSelect);

    async function handleBulkUpload(e) {
        e.preventDefault();
        
        const fileInput = document.getElementById('questionsFileInput');
        const uploadBtn = document.getElementById('uploadBtn');
        const file = fileInput.files[0];
        
        if (!file) {
            alert('Please select a JSON file first.');
            return;
        }
        
        const formData = new FormData();
        formData.append('questionsFile', file);
        
        const uploadProgress = document.getElementById('uploadProgress');
        const progressBar = document.getElementById('progressBar');
        const progressText = document.getElementById('progressText');
        const processingIndicator = document.getElementById('processingIndicator');
        const resultsSection = document.getElementById('resultsSection');
        const skippedQuestionsSection = document.getElementById('skippedQuestionsSection');
        
        uploadProgress.style.display = 'block';
        processingIndicator.style.display = 'block';
        resultsSection.style.display = 'none';
        uploadBtn.disabled = true;
        
        try {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', e.target.action, true);
            
            xhr.upload.addEventListener('progress', function(evt) {
                if (evt.lengthComputable) {
                    const percent = Math.round((evt.loaded / evt.total) * 100);
                    progressBar.style.width = percent + '%';
                    progressText.textContent = percent + '%';
                }
            });
            
            const response = await new Promise((resolve, reject) => {
                xhr.onload = function() {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        try {
                            const parsed = JSON.parse(xhr.responseText);
                            if (!parsed || typeof parsed !== 'object') {
                                reject(new Error('Invalid server response. Please try again.'));
                                return;
                            }
                            resolve(parsed);
                        } catch (parseErr) {
                            const trimmed = (xhr.responseText || '').trim();
                            if (trimmed.startsWith('<!') || trimmed.startsWith('<html')) {
                                reject(new Error('Session expired or access denied. Please refresh and log in again.'));
                            } else {
                                reject(new Error('Invalid server response. Please try again.'));
                            }
                        }
                    } else {
                        let errorMsg = 'Upload failed (status: ' + xhr.status + ')';
                        const trimmed = (xhr.responseText || '').trim();
                        if (trimmed) {
                            try {
                                const err = JSON.parse(trimmed);
                                errorMsg = err.message || errorMsg;
                            } catch (e) {
                                // Likely an HTML redirect/login page
                                if (trimmed.startsWith('<!') || trimmed.startsWith('<html')) {
                                    errorMsg = 'Session expired or access denied. Please refresh and log in again.';
                                } else {
                                    errorMsg = errorMsg + ': ' + trimmed.substring(0, 120);
                                }
                            }
                        }
                        reject(new Error(errorMsg));
                    }
                };
                xhr.onerror = function() {
                    reject(new Error('Network error occurred. Please check your connection.'));
                };
                xhr.send(formData);
            });
            
            uploadProgress.style.display = 'none';
            processingIndicator.style.display = 'none';
            resultsSection.style.display = 'block';
            
            if (response.success) {
                document.getElementById('createdCount').textContent = response.summary.created;
                document.getElementById('skippedCount').textContent = response.summary.skipped;
                document.getElementById('errorCount').textContent = response.summary.errors;
                document.getElementById('totalCount').textContent = response.summary.total;
                
                if (response.skippedQuestions && response.skippedQuestions.length > 0) {
                    skippedQuestionsSection.style.display = 'block';
                    const skippedTableBody = document.getElementById('skippedTableBody');
                    
                    let tableHtml = '';
                    response.skippedQuestions.forEach((sq, index) => {
                        tableHtml += `
                            <tr>
                                <td>${sq.originalIndex || index + 1}</td>
                                <td>${escapeHtml(sq.questionText)}</td>
                                <td><span class="badge bg-warning text-dark">${escapeHtml(sq.reason)}</span></td>
                                <td>
                                    <button class="btn btn-sm btn-primary create-skipped-btn" 
                                            data-question-text="${escapeHtml(sq.questionText)}"
                                            data-options='${escapeHtml(JSON.stringify(sq.options || []))}'
                                            data-explanation="${escapeHtml(sq.explanation || '')}">
                                        <i class="bi bi-plus-lg"></i> Create
                                    </button>
                                </td>
                            </tr>
                        `;
                    });
                    skippedTableBody.innerHTML = tableHtml;
                    
                    document.querySelectorAll('.create-skipped-btn').forEach(btn => {
                        btn.addEventListener('click', function() {
                            createSkippedQuestion(this);
                        });
                    });
                } else {
                    skippedQuestionsSection.style.display = 'none';
                }
            } else {
                alert(response.message || 'Upload failed');
            }
        } catch (err) {
            uploadProgress.style.display = 'none';
            processingIndicator.style.display = 'none';
            alert('Error: ' + err.message);
        } finally {
            uploadBtn.disabled = false;
        }
    }

    async function createSkippedQuestion(btn) {
        const questionText = btn.dataset.questionText;
        const rawOptions = JSON.parse(btn.dataset.options || '[]');
        const explanation = btn.dataset.explanation;
        
        // Convert bulk format to API format
        const apiOptions = rawOptions.map((text, idx) => ({
            text: text,
            letter: String.fromCharCode(65 + idx),
            isCorrect: idx === 0
        }));
        
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
        
        try {
            const response = await fetch('/quizzes/<%= quiz.quizId %>/questions/api', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    courseId: '<%= quiz.courseId %>',
                    questionText: questionText,
                    explanation: explanation,
                    options: apiOptions
                }),
                credentials: 'same-origin'
            });
            
            const data = await response.json();
            
            if (data.success) {
                const row = btn.closest('tr');
                row.innerHTML = `
                    <td colspan="4" class="text-success">
                        <i class="bi bi-check-circle"></i> Created successfully! (ID: ${data.data.questionId})
                    </td>
                `;
            } else {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-plus-lg"></i> Create';
                alert('Failed: ' + (data.message || 'Unknown error'));
            }
        } catch (err) {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-plus-lg"></i> Create';
            alert('Error: ' + err.message);
        }
    }

    async function createAllSkippedQuestions() {
        const buttons = document.querySelectorAll('.create-skipped-btn:not(:disabled)');
        if (buttons.length === 0) {
            alert('No skipped questions to create.');
            return;
        }

        const createAllBtn = document.getElementById('createAllSkippedBtn');
        const originalText = createAllBtn.innerHTML;
        createAllBtn.disabled = true;
        createAllBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Creating...';

        let successCount = 0;
        let failCount = 0;

        for (const btn of buttons) {
            try {
                await createSkippedQuestion(btn);
                successCount++;
            } catch (err) {
                failCount++;
            }
            // Small delay between requests to avoid overwhelming the server
            await new Promise(resolve => setTimeout(resolve, 300));
        }

        createAllBtn.innerHTML = originalText;
        createAllBtn.disabled = false;

        if (failCount === 0) {
            alert(`All ${successCount} questions created successfully!`);
        } else {
            alert(`Completed: ${successCount} created, ${failCount} failed. Check the table for details.`);
        }
    }

    document.getElementById('createAllSkippedBtn').addEventListener('click', createAllSkippedQuestions);
    document.getElementById('bulkUploadForm').addEventListener('submit', handleBulkUpload);
</script>

<!-- quizzes/index.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Quizzes</h1>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-primary"><%= total || 0 %> quizzes</span>
      <a href="/quizzes/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg"></i> Add Quiz
      </a>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <!-- Search & Filter -->
  <div class="row">
    <div class="col-12">
      <button class="btn btn-outline-secondary my-3 filter-btn" type="button">
        <i class="bi bi-funnel"></i>
        Filters
      </button>
      <form method="GET" action="/quizzes" class="mb-3 filter-area d-none">
        <div class="d-flex flex-column g-2 align-items-start">
          <div class="col-sm-3 col-md-3">
            <label for="quizSearch" class="form-label small text-muted">Search</label>
            <input type="text" class="form-control form-control-sm" id="quizSearch" name="q" placeholder="Search by title or course..." value="<%= typeof q !== 'undefined' ? q : '' %>">
          </div>
          <div class="col-sm-3 col-md-3">
            <label for="typeFilter" class="form-label small text-muted">Type</label>
            <select class="form-select form-select-sm" id="typeFilter" name="type">
              <option value="all" <%= (typeof type === 'undefined' || type === 'all') ? 'selected' : '' %>>All</option>
              <option value="quiz" <%= typeof type !== 'undefined' && type === 'quiz' ? 'selected' : '' %>>Quiz</option>
              <option value="midterm" <%= typeof type !== 'undefined' && type === 'midterm' ? 'selected' : '' %>>Midterm</option>
              <option value="finalterm" <%= typeof type !== 'undefined' && type === 'finalterm' ? 'selected' : '' %>>Final Term</option>
            </select>
          </div>
          <div class="col-sm-2 mt-3">
            <div class="d-flex gap-2">
              <a href="/quizzes" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-lg"></i>
                <span>Reset</span>
              </a>
              <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-check-lg"></i>
                <span>Apply</span>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <% if (typeof quizzes !== 'undefined' && quizzes.length > 0) { %>
  <table class="table table-hover align-middle">
    <thead>
      <tr class="sticky-table-header">
        <th>Quiz Title</th>
        <th>Course</th>
        <th>Type</th>
        <th class="text-center">Questions</th>
        <th>Created</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% quizzes.forEach(function(q) { %>
      <tr>
        <td>
          <a href="/quizzes/<%= q.quizId %>" class="text-decoration-none fw-medium">
            <%= q.title || '-' %>
          </a>
        </td>
        <td>
          <a href="/courses/<%= q.courseId %>" class="text-decoration-none fw-medium" title="View <%= q.courseCode %> course">
            <span class="fw-semibold"><%= q.courseCode %></span>
          </a>
          <a href="/courses/<%= q.courseId %>" class="text-decoration-none fw-medium" title="View <%= q.courseCode %> course">
            <small class="d-block text-muted"><%= q.courseName %></small>
          </a>
        </td>
        <td><span class="badge bg-secondary"><%= q.type || 'quiz' %></span></td>
        <td class="text-center fw-bold"><%= q.question_count || 0 %></td>
        <td class="text-muted small"><%= q.createdAt ? new Date(q.createdAt).toLocaleDateString() : '-' %></td>
        <td class="text-end">
          <a href="/quizzes/<%= q.quizId %>/edit" class="btn btn-sm btn-outline-primary" title="Manage Questions">
            <i class="bi bi-list-check"></i>
          </a>
          <form action="/quizzes/<%= q.quizId %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this quiz and all its questions?')">
            <button type="submit" class="btn btn-sm btn-outline-danger">
              <i class="bi bi-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>

  <!-- Pagination -->
  <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
  <% const qs = []; if (typeof q !== 'undefined' && q) qs.push('q=' + encodeURIComponent(q)); if (typeof type !== 'undefined' && type && type !== 'all') qs.push('type=' + encodeURIComponent(type)); const qsStr = qs.length ? '&' + qs.join('&') : ''; %>
  <nav>
    <ul class="pagination justify-content-center">
      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page - 1 %><%= qsStr %>">Previous</a>
      </li>
      <li class="page-item disabled">
        <span class="page-link">Page <%= pagination.page %> of <%= pagination.pages %></span>
      </li>
      <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= pagination.page + 1 %><%= qsStr %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
  <% } else { %>
  <div class="text-center py-5">
    <i class="bi bi-clipboard-check display-1 text-muted mb-3"></i>
    <h5 class="text-muted">No quizzes found</h5>
    <a href="/quizzes/new" class="btn btn-primary mt-2">
      <i class="bi bi-plus-lg"></i> Add your first quiz
    </a>
  </div>
  <% } %>
</div>
<!-- quizzes/_form.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><%= mode === 'new' ? 'Add Quiz' : 'Edit Quiz' %></h1>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <div class="row g-4">
    <!-- Quiz Metadata -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom">
          <h5 class="mb-0">Quiz Details</h5>
        </div>
        <div class="card-body">
          <% if (mode === 'edit' && quiz) { %>
          <form action="/quizzes/<%= quiz.quizId %>" method="POST">
            <% } else { %>
            <form action="/quizzes" method="POST">
              <% } %>

              <div class="mb-3">
                <label class="form-label fw-bold">Course <span class="text-danger">*</span></label>
                <input type="hidden" name="courseId" id="courseIdInput"
                  value="<%= quiz ? quiz.courseId : (selectedCourseId || '') %>">
                <div class="course-search-wrapper position-relative">
                  <input type="text" id="courseSearchInput" class="form-control"
                    placeholder="Type course code or name..."
                    autocomplete="off"
                    value="<%= quiz ? (quiz.courseCode + ' - ' + quiz.courseName) : '' %>">
                  <button type="button" id="courseSearchClear" class="btn btn-sm btn-outline-secondary position-absolute course-search-clear" title="Clear selection">
                    <i class="bi bi-x-lg"></i>
                  </button>
                  <div id="courseSearchDropdown" class="list-group position-absolute w-100 course-search-dropdown shadow-sm" style="display:none; z-index:1050; max-height:220px; overflow-y:auto;"></div>
                  <div id="courseSearchSpinner" class="position-absolute course-search-spinner" style="display:none;">
                    <span class="spinner-border spinner-border-sm text-primary"></span>
                  </div>
                </div>
                <div class="invalid-feedback d-block" id="courseSearchError" style="display:none;">Please select a course.</div>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Quiz Title <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="title" value="<%= quiz ? quiz.title : '' %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Type</label>
                <select name="type" class="form-select">
                  <option value="quiz" <%= quiz && quiz.type === 'quiz' ? 'selected' : '' %>>Quiz</option>
                  <option value="midterm" <%= quiz && quiz.type === 'midterm' ? 'selected' : '' %>>Midterm</option>
                  <option value="finalterm" <%= quiz && quiz.type === 'finalterm' ? 'selected' : '' %>>Final Term</option>
                </select>
              </div>
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-check-lg"></i> <%= mode === 'new' ? 'Create Quiz' : 'Update Quiz' %>
              </button>
            </form>
        </div>
      </div>
    </div>

    <!-- Questions Management -->
    <% if (mode === 'edit' && quiz) { %>
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Questions (<%= questions ? questions.length : 0 %>)</h5>
          <a href="/quizzes/<%= quiz.quizId %>/questions/new" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Add Question
          </a>
        </div>
        <div class="card-body p-0">
          <% if (questions && questions.length > 0) { %>
          <div class="list-group list-group-flush">
            <% questions.forEach(function(q, i) { %>
            <div class="list-group-item">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1 me-3" style="min-width: 0;">
                  <div class="d-flex align-items-start">
                    <span class="badge bg-primary me-2 mt-1 flex-shrink-0"><%= i + 1 %></span>
                    <div class="flex-grow-1" style="min-width: 0;">
                      <p class="mb-1 fw-medium text-break"><%= q.questionText %></p>
                      <% if (q.explanation) { %>
                      <small class="text-muted d-block mb-2 text-break">Explanation: <%= q.explanation %></small>
                      <% } %>
                      <div class="d-flex flex-wrap gap-1">
                        <% (q.options || []).forEach(function(opt) { %>
                        <span class="badge bg-<%= opt.isCorrect ? 'success' : 'light text-dark' %> border text-break" style="white-space: normal;">
                          <%= opt.letter %>. <%= opt.optionText %>
                        </span>
                        <% }); %>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="d-none d-md-flex gap-1 flex-shrink-0">
                  <a href="/questions/<%= q.questionId %>/edit" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <form action="/questions/<%= q.questionId %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this question?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
                <div class="dropdown d-block d-md-none">
                  <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/questions/<%= q.questionId %>/edit"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <form action="/questions/<%= q.questionId %>/delete" method="POST" onsubmit="return confirm('Delete this question?')">
                        <button class="dropdown-item text-danger" type="submit"><i class="bi bi-trash me-2"></i>Delete</button>
                      </form>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <div class="text-center py-5">
            <i class="bi bi-question-circle display-4 text-muted"></i>
            <h5 class="text-muted mt-2">No questions yet</h5>
            <a href="/quizzes/<%= quiz.quizId %>/questions/new" class="btn btn-primary mt-2">
              <i class="bi bi-plus-lg"></i> Add first question
            </a>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

<style>
  .course-search-wrapper .course-search-clear {
    top: 50%; right: 8px; transform: translateY(-50%);
    border: none; background: none; padding: 2px 6px; line-height: 1;
    display: none;
  }
  .course-search-wrapper .course-search-clear.visible { display: block; }
  .course-search-wrapper .course-search-spinner {
    top: 50%; right: 34px; transform: translateY(-50%);
  }
  .course-search-dropdown {
    top: 100%; left: 0; border-top: 0; border-radius: 0 0 .375rem .375rem;
  }
  .course-search-dropdown .list-group-item {
    cursor: pointer; border-left: 0; border-right: 0;
  }
  .course-search-dropdown .list-group-item:first-child { border-top: 0; }
  .course-search-dropdown .list-group-item:hover,
  .course-search-dropdown .list-group-item.active {
    background-color: var(--bs-primary); color: #fff;
  }
</style>

<script>
(function () {
  var searchInput = document.getElementById('courseSearchInput');
  var courseIdInput = document.getElementById('courseIdInput');
  var dropdown = document.getElementById('courseSearchDropdown');
  var spinner = document.getElementById('courseSearchSpinner');
  var clearBtn = document.getElementById('courseSearchClear');
  var errorEl = document.getElementById('courseSearchError');
  var debounceTimer = null;
  var selectedIndex = -1;

  function showDropdown(items) {
    if (!items || items.length === 0) {
      dropdown.innerHTML = '<div class="list-group-item text-muted">No courses found</div>';
    } else {
      dropdown.innerHTML = items.map(function (c, i) {
        return '<button type="button" class="list-group-item list-group-item-action" data-id="' + c.courseId + '" data-label="' + c.courseCode + ' - ' + c.courseName + '" data-index="' + i + '">'
          + '<span class="fw-bold">' + c.courseCode + '</span> - ' + c.courseName
          + '</button>';
      }).join('');
    }
    dropdown.style.display = 'block';
    selectedIndex = -1;
  }

  function hideDropdown() {
    dropdown.style.display = 'none';
    selectedIndex = -1;
  }

  function selectCourse(id, label) {
    courseIdInput.value = id;
    searchInput.value = label;
    clearBtn.classList.add('visible');
    errorEl.style.display = 'none';
    searchInput.classList.remove('is-invalid');
    hideDropdown();
  }

  function clearSelection() {
    courseIdInput.value = '';
    searchInput.value = '';
    clearBtn.classList.remove('visible');
    searchInput.focus();
  }

  function doSearch() {
    var q = searchInput.value.trim();
    if (q.length < 2) { hideDropdown(); return; }
    spinner.style.display = 'block';
    fetch('/api/courses/search?q=' + encodeURIComponent(q) + '&limit=15', { credentials: 'same-origin' })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        spinner.style.display = 'none';
        if (json.success) showDropdown(json.data);
        else showDropdown([]);
      })
      .catch(function () { spinner.style.display = 'none'; showDropdown([]); });
  }

  searchInput.addEventListener('input', function () {
    courseIdInput.value = '';
    clearBtn.classList.add('visible');
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(doSearch, 300);
  });

  searchInput.addEventListener('focus', function () {
    var q = searchInput.value.trim();
    if (q.length >= 2 && !courseIdInput.value) doSearch();
  });

  searchInput.addEventListener('keydown', function (e) {
    var items = dropdown.querySelectorAll('.list-group-item[data-id]');
    if (!items.length) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
      updateHighlight(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = Math.max(selectedIndex - 1, 0);
      updateHighlight(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedIndex >= 0 && items[selectedIndex]) {
        selectCourse(items[selectedIndex].dataset.id, items[selectedIndex].dataset.label);
      }
    } else if (e.key === 'Escape') {
      hideDropdown();
    }
  });

  function updateHighlight(items) {
    items.forEach(function (el, i) { el.classList.toggle('active', i === selectedIndex); });
  }

  dropdown.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-id]');
    if (btn) selectCourse(btn.dataset.id, btn.dataset.label);
  });

  clearBtn.addEventListener('click', clearSelection);

  document.addEventListener('click', function (e) {
    if (!e.target.closest('.course-search-wrapper')) hideDropdown();
  });

  if (courseIdInput.value) clearBtn.classList.add('visible');

  searchInput.closest('form').addEventListener('submit', function (e) {
    if (!courseIdInput.value) {
      e.preventDefault();
      errorEl.style.display = 'block';
      searchInput.classList.add('is-invalid');
      searchInput.focus();
    } else {
      errorEl.style.display = 'none';
      searchInput.classList.remove('is-invalid');
    }
  });
})();
</script>

  </div>
</div>
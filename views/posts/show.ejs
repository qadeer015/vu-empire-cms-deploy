<!-- posts/show.ejs -->
<% let thumb = null;
   if (post.thumbnail) {
     const t = post.thumbnail;
     if (typeof t === 'string') thumb = t;
     else if (Array.isArray(t) && t.length) thumb = (typeof t[0] === 'string') ? t[0] : (t[0].original || t[0].url || null);
     else if (typeof t === 'object') thumb = t.original || t.url || null;
   }

   // ── Normalize content per type ──────────────────────────────
   const rawContent = post.content || '';
   let parsed = null;
   try { parsed = JSON.parse(rawContent); } catch (e) { parsed = null; }

   let pollData = null;       // poll: { options: [...] }
   let contentText = null;    // main body text
   let contentFile = null;    // document/file attachment { name, url }
   let contentImages = [];    // attached images
   let contentFields = [];    // remaining scalar key/value pairs (events etc.)

   const textKeys = ['content', 'text', 'body', 'description', 'details', 'message'];
   const fileKeys = ['file', 'document', 'attachment', 'url', 'fileUrl', 'documentUrl', 'driveLink', 'link'];
   const imageKeys = ['images', 'image'];

   if (post.content_type === 'poll' && parsed && Array.isArray(parsed.options)) {
     pollData = parsed;
     if (parsed.question || parsed.title) contentText = parsed.question || parsed.title;
   } else if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
     if (typeof parsed.original === 'string' && parsed.original && !parsed.original.trim().startsWith('{')) {
       contentText = parsed.original;
     }
     for (const [key, value] of Object.entries(parsed)) {
       if (key === 'original' && contentText === parsed.original) continue;
       if (imageKeys.includes(key)) {
         const imgs = Array.isArray(value) ? value : [value];
         imgs.forEach(function (img) {
           if (typeof img === 'string') contentImages.push({ url: img, name: null });
           else if (img && (img.url || img.original || img.secure_url)) contentImages.push({ url: img.url || img.original || img.secure_url, name: img.name || img.public_id || null });
         });
       } else if (fileKeys.includes(key) && (typeof value === 'string' || (value && typeof value === 'object'))) {
         if (typeof value === 'string') {
           if (!contentFile) contentFile = { url: value.toLowerCase().startsWith('http') ? value : null, name: value };
         } else if (value.url || value.secure_url || value.original || value.filePath) {
           contentFile = { url: value.url || value.secure_url || value.original || value.filePath, name: value.name || value.originalFilename || value.public_id || null };
         }
       } else if (textKeys.includes(key) && typeof value === 'string' && !contentText) {
         contentText = value;
       } else if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
         contentFields.push({ key: key, value: String(value) });
       } else if (value && typeof value === 'object') {
         try { contentFields.push({ key: key, value: JSON.stringify(value) }); } catch (e) {}
       }
     }
   } else if (typeof parsed === 'string') {
     contentText = parsed;
   } else {
     contentText = rawContent;
   }

   const statusBadge = post.status === 'publish' ? 'success' : post.status === 'pending' ? 'warning text-dark' : post.status === 'reject' ? 'danger' : 'secondary';
   const canApprove = ['pending', 'reject'].includes(post.status);
   const canReject = post.status === 'pending';
   const canUnpublish = post.status === 'publish';
   const canDelete = post.status !== 'delete';
%>
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
      <div class="d-flex align-items-center gap-2">
        <h1 class="h3 mb-0"><%= post.title %></h1>
        <span class="badge bg-<%= statusBadge %>"><%= post.status %></span>
        <span class="badge bg-<%= post.content_type === 'event' ? 'info' : post.content_type === 'poll' ? 'warning text-dark' : post.content_type === 'document' ? 'secondary' : 'primary' %>"><%= post.content_type || 'post' %></span>
      </div>
      <p class="text-muted mb-0">
        by <%= post.authorName || '-' %> &middot; <%= post.createdAt ? new Date(post.createdAt).toLocaleString() : '-' %>
      </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <!-- View on site -->
      <a href="<%= publicPostUrl %>" target="_blank" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-box-arrow-up-right"></i> View
      </a>
      <% if (canApprove) { %>
      <form action="/posts/<%= post.id %>/review" method="POST" class="d-inline" onsubmit="return confirm('Approve and publish this post?')">
        <input type="hidden" name="status" value="publish">
        <button type="submit" class="btn btn-sm btn-success">
          <i class="bi bi-check-lg"></i> Approve
        </button>
      </form>
      <% } %>
      <% if (canReject) { %>
      <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
        <i class="bi bi-x-lg"></i> Reject
      </button>
      <% } %>
      <% if (canUnpublish) { %>
      <form action="/posts/<%= post.id %>/review" method="POST" class="d-inline" onsubmit="return confirm('Unpublish this post back to review?')">
        <input type="hidden" name="status" value="reject">
        <button type="submit" class="btn btn-sm btn-outline-warning">
          <i class="bi bi-arrow-counterclockwise"></i> Unpublish
        </button>
      </form>
      <% } %>
      <% if (canDelete) { %>
      <form action="/posts/<%= post.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this post?')">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-trash"></i> Delete
        </button>
      </form>
      <% } %>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <!-- ── Analytics cards ─────────────────────────────── -->
  <div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small mb-1">Views</p>
              <h4 class="mb-0 fw-bold"><%= stats.totalViews %></h4>
              <small class="text-muted"><%= stats.uniqueUsers %> logged-in &middot; <%= stats.anonymousViews %> guest</small>
            </div>
            <i class="bi bi-eye fs-2 text-primary"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small mb-1">Reactions</p>
              <h4 class="mb-0 fw-bold"><%= stats.totalReactions %></h4>
              <small class="text-muted"><i class="bi bi-hand-thumbs-up"></i> <%= reactions.like %> &middot; <i class="bi bi-heart text-danger"></i> <%= reactions.heart %> &middot; <i class="bi bi-emoji-laughing text-warning"></i> <%= reactions.laugh %> &middot; <i class="bi bi-emoji-angry text-danger"></i> <%= reactions.anger %></small>
            </div>
            <i class="bi bi-emoji-smile fs-2 text-warning"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small mb-1">Comments</p>
              <h4 class="mb-0 fw-bold"><%= stats.totalComments %></h4>
              <small class="text-muted"><%= stats.commentsLast7Days %> in last 7 days</small>
            </div>
            <i class="bi bi-chat-dots fs-2 text-info"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <p class="text-muted small mb-1">Engagement Rate</p>
              <h4 class="mb-0 fw-bold"><%= stats.engagementRate %>%</h4>
              <small class="text-muted"><%= stats.viewsLast7Days %> views last 7 days</small>
            </div>
            <i class="bi bi-graph-up fs-2 text-success"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <!-- ── Post content (rendered per content type) ── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><i class="bi bi-file-text me-2"></i>Content</h6>
          <span class="badge bg-<%= post.content_type === 'event' ? 'info' : post.content_type === 'poll' ? 'warning text-dark' : post.content_type === 'document' ? 'secondary' : 'primary' %>"><%= post.content_type || 'post' %></span>
        </div>
        <div class="card-body">
          <% if (thumb) { %>
          <img src="<%= thumb %>" class="img-fluid rounded mb-3" alt="<%= post.title %>">
          <% } %>

          <% if (pollData) { %>
          <!-- Poll -->
          <% if (contentText) { %>
            <% const pollQIsHtml = /<\/?(?:p|div|span|strong|b|em|i|u|s|ul|ol|li|br|hr|h[1-6]|img|a|blockquote|pre|code|table|tr|td|th|figure|figcaption)\b[^>]*>/i.test(contentText); %>
            <% if (pollQIsHtml) { %>
          <div class="post-content mb-2"><%- sanitizeHtml(contentText) %></div>
            <% } else { %>
          <p class="mb-2"><%= contentText %></p>
            <% } %>
          <% } %>
          <ul class="list-group list-group-flush">
            <% pollData.options.forEach(function(opt, i) { %>
            <li class="list-group-item px-0">
              <span class="badge bg-light text-dark border me-2"><%= String.fromCharCode(65 + i) %></span>
              <%= typeof opt === 'string' ? opt : (opt.text || opt.optionText || JSON.stringify(opt)) %>
            </li>
            <% }); %>
          </ul>
          <% } else { %>
          <!-- Post / Event / Document -->
          <% if (contentText) { %>
            <% const isHtmlContent = /<\/?(?:p|div|span|strong|b|em|i|u|s|ul|ol|li|br|hr|h[1-6]|img|a|blockquote|pre|code|table|tr|td|th|figure|figcaption|script|style|iframe)\b[^>]*>/i.test(contentText); %>
            <% if (isHtmlContent) { %>
          <!-- Rich text content (sanitized before rendering) -->
          <div class="post-content mb-3"><%- sanitizeHtml(contentText) %></div>
            <% } else { %>
          <p class="mb-3" style="white-space: pre-wrap;"><%= contentText %></p>
            <% } %>
          <% } %>

          <% if (contentFields.length > 0) { %>
          <!-- Event fields / extra metadata -->
          <dl class="row mb-3">
            <% contentFields.forEach(function(f) { %>
            <dt class="col-sm-4 small fw-normal text-muted"><%= f.key %></dt>
            <dd class="col-sm-8 small"><%= f.value %></dd>
            <% }); %>
          </dl>
          <% } %>

          <% if (contentImages.length > 0) { %>
          <!-- Attached images -->
          <div class="row g-2 mb-3">
            <% contentImages.forEach(function(img) { %>
            <div class="col-6 col-md-4">
              <a href="<%= img.url %>" target="_blank">
                <img src="<%= img.url %>" class="img-fluid rounded border" alt="<%= img.name || 'image' %>">
              </a>
            </div>
            <% }); %>
          </div>
          <% } %>

          <% if (contentFile) { %>
          <!-- Document attachment -->
          <div class="border rounded p-3 d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-2 text-truncate">
              <i class="bi bi-file-earmark-text fs-4 text-secondary"></i>
              <span class="small text-truncate"><%= contentFile.name || 'Attached document' %></span>
            </div>
            <% if (contentFile.url) { %>
            <a href="<%= contentFile.url %>" target="_blank" class="btn btn-sm btn-outline-primary flex-shrink-0">
              <i class="bi bi-download"></i> Download
            </a>
            <% } %>
          </div>
          <% } %>

          <% if (!contentText && contentFields.length === 0 && contentImages.length === 0 && !contentFile) { %>
          <p class="text-muted mb-0 fst-italic">No content available.</p>
          <% } %>
          <% } %>
        </div>
      </div>

      <!-- ── Views chart (last 7 days) ────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom">
          <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Views &mdash; last 7 days</h6>
        </div>
        <div class="card-body">
          <canvas id="viewsChart" height="90"></canvas>
        </div>
      </div>

      <!-- ── Recent comments ─────────────────────────── -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-bottom">
          <h6 class="mb-0"><i class="bi bi-chat-dots me-2"></i>Recent comments</h6>
        </div>
        <div class="card-body">
          <% if (comments.length > 0) { %>
          <% comments.forEach(function(c, ci) { %>
          <div class="d-flex gap-3 mb-3 pb-3 <%= ci < comments.length - 1 ? 'border-bottom' : '' %>">
            <% if (c.avatar && c.avatar !== '/avatars/default.png') { %>
            <img src="<%= c.avatar %>" class="rounded-circle flex-shrink-0" style="width:36px;height:36px;object-fit:cover;" alt="">
            <% } else { %>
            <span class="rounded-circle bg-primary bg-opacity-10 text-primary fw-medium d-flex align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;font-size:14px;"><%= c.authorName ? c.authorName[0].toUpperCase() : '?' %></span>
            <% } %>
            <div class="flex-grow-1">
              <div class="d-flex justify-content-between">
                <strong class="small"><%= c.authorName || 'Unknown' %></strong>
                <small class="text-muted"><%= c.createdAt ? new Date(c.createdAt).toLocaleString() : '-' %></small>
              </div>
              <p class="mb-0 small"><%= c.content %></p>
            </div>
          </div>
          <% }); %>
          <% } else { %>
          <p class="text-muted mb-0">No comments yet.</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <!-- ── Details sidebar ──────────────────────────── -->
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-bottom">
          <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Details &amp; Review</h6>
        </div>
        <div class="card-body small">
          <p class="mb-1"><strong>ID:</strong> <%= post.id %></p>
          <p class="mb-1"><strong>Slug:</strong> <code><%= post.slug %></code></p>
          <p class="mb-1"><strong>Author:</strong> <%= post.authorName || '-' %>
            <% if (post.authorEmail) { %>&lt;<a href="mailto:<%= post.authorEmail %>" class="text-decoration-none"><%= post.authorEmail %></a>&gt;<% } %>
          </p>
          <p class="mb-1"><strong>Status:</strong> <span class="badge bg-<%= statusBadge %>"><%= post.status %></span></p>
          <% if (post.rejectReason) { %>
          <div class="alert alert-danger py-2 px-3 small mt-2">
            <strong>Reject reason:</strong> <%= post.rejectReason %>
          </div>
          <% } %>
          <p class="mb-1"><strong>Reviewed by:</strong> <%= post.reviewedByName || '-' %></p>
          <p class="mb-1"><strong>Reviewed at:</strong> <%= post.reviewedAt ? new Date(post.reviewedAt).toLocaleString() : '-' %></p>
          <p class="mb-1"><strong>Created:</strong> <%= post.createdAt ? new Date(post.createdAt).toLocaleString() : '-' %></p>
          <p class="mb-0"><strong>Updated:</strong> <%= post.updatedAt ? new Date(post.updatedAt).toLocaleString() : '-' %></p>
          <hr>
          <p class="small text-muted mb-0">
            <i class="bi bi-info-circle me-1"></i>
            Approving a pending post publishes it and emails the author. Rejecting sends the author a notification with the reason.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (canReject) { %>
<!-- Reject modal (only for pending posts) -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form action="/posts/<%= post.id %>/review" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="rejectModalLabel">Reject post</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <label for="rejectReason" class="form-label small text-muted">Reason (sent to the author by email)</label>
        <textarea class="form-control" id="rejectReason" name="rejectReason" rows="3" placeholder="Explain why this post is rejected..." required></textarea>
        <input type="hidden" name="status" value="reject">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger btn-sm">
          <i class="bi bi-x-lg"></i> Reject post
        </button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Move the modal to <body> so it is not trapped in the layout's
    // z-index stacking context (fixes backdrop/overlay issues).
    var modal = document.getElementById('rejectModal');
    if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
    }

    var ctx = document.getElementById('viewsChart');
    if (!ctx || typeof Chart === 'undefined') return;
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: <%- JSON.stringify(stats.daily.map(function(d) { return d.date; })) %>,
            datasets: [{
                label: 'Views',
                data: <%- JSON.stringify(stats.daily.map(function(d) { return d.count; })) %>,
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                fill: true,
                tension: 0.3,
                pointRadius: 3
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });
});
</script>

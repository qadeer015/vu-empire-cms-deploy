<!-- admin/dashboard.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Dashboard</h1>
    <span class="text-muted">Welcome back, <%= user.name || user.studentName || 'Admin' %></span>
  </div>

  <!-- Stat Cards -->
  <% if (typeof adminStats !== 'undefined') { %>
  <div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <i class="bi bi-journal-bookmark display-6 text-primary"></i>
          <h2 class="mt-2 mb-0"><%= adminStats.totalCourses || 0 %></h2>
          <small class="text-muted">Courses</small>
        </div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <i class="bi bi-clipboard-check display-6 text-success"></i>
          <h2 class="mt-2 mb-0"><%= adminStats.totalQuizzes || 0 %></h2>
          <small class="text-muted">Quizzes</small>
        </div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <i class="bi bi-question-circle display-6 text-warning"></i>
          <h2 class="mt-2 mb-0"><%= adminStats.totalQuestions || 0 %></h2>
          <small class="text-muted">Questions</small>
        </div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <i class="bi bi-file-earmark-pdf display-6 text-danger"></i>
          <h2 class="mt-2 mb-0"><%= adminStats.totalPastPapers || 0 %></h2>
          <small class="text-muted">Past Papers</small>
        </div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <i class="bi bi-pencil-square display-6 text-info"></i>
          <h2 class="mt-2 mb-0"><%= adminStats.totalAssignments || 0 %></h2>
          <small class="text-muted">Assignments</small>
        </div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body text-center">
          <i class="bi bi-chat-dots display-6 text-secondary"></i>
          <h2 class="mt-2 mb-0"><%= adminStats.totalGdbSolutions || 0 %></h2>
          <small class="text-muted">GDB Solutions</small>
        </div>
      </div>
    </div>
  </div>

  <!-- This Month New Content -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">New This Month</h6>
              <h4 class="mb-0">
                <%= (adminStats.newCourses || 0) + (adminStats.newQuizzes || 0) + (adminStats.newQuestions || 0) %>
                <small class="fs-6 text-muted">items</small>
              </h4>
            </div>
            <i class="bi bi-graph-up-arrow display-6 text-success"></i>
          </div>
          <div class="mt-3 small">
            <span class="badge bg-primary"><%= adminStats.newCourses || 0 %> courses</span>
            <span class="badge bg-success"><%= adminStats.newQuizzes || 0 %> quizzes</span>
            <span class="badge bg-warning text-dark"><%= adminStats.newQuestions || 0 %> questions</span>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Total Submissions</h6>
              <h4 class="mb-0"><%= adminStats.totalSubmissions || 0 %></h4>
            </div>
            <i class="bi bi-people display-6 text-info"></i>
          </div>
          <div class="mt-3 small text-muted">Student quiz submissions recorded</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted mb-1">Days Active</h6>
              <h4 class="mb-0"><%= overallStats && overallStats.days_active || 0 %></h4>
            </div>
            <i class="bi bi-calendar-check display-6 text-warning"></i>
          </div>
          <div class="mt-3 small text-muted">Days with question activity</div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Course Stats Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-bottom">
      <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Course Statistics</h5>
    </div>
    <div class="card-body p-0">
      <% if (typeof courseStats !== 'undefined' && courseStats.length > 0) { %>
      <div class="table-responsive" style="max-height: 60vh; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #adb5bd #f8f9fa;">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
            <tr>
              <th>Course</th>
              <th width="13.3%" class="text-center">Questions</th>
              <th width="13.3%" class="text-center">Quizzes</th>
              <th width="13.3%" class="text-center">Past Papers</th>
              <th width="13.3%" class="text-center">Assignments</th>
              <th width="13.3%" class="text-center">GDBs</th>
              <th width="13.3%">Last Updated</th>
            </tr>
          </thead>
          <tbody>
            <% courseStats.forEach(function(c) { %>
            <tr>
              <td>
                <span class="fw-semibold"><%= c.courseCode %></span>
                <small class="d-block text-muted"><%= c.courseName %></small>
              </td>
              <td class="text-center fw-bold"><%= c.question_count || 0 %></td>
              <td class="text-center"><%= c.quiz_count || 0 %></td>
              <td class="text-center"><%= c.past_paper_count || 0 %></td>
              <td class="text-center"><%= c.assignment_count || 0 %></td>
              <td class="text-center"><%= c.gdb_count || 0 %></td>
              <td class="text-muted small"><%= c.last_updated || '-' %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <div class="text-center py-5">
        <i class="bi bi-journal-bookmark display-4 text-muted"></i>
        <h5 class="text-muted mt-2">No courses found</h5>
      </div>
      <% } %>
    </div>
  </div>
</div>
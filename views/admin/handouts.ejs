<!-- pages/handouts.ejs -->
<div class="container py-4" data-controller="handouts">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Handouts</h1>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary" data-target="handouts.countBadge"></span>
            <div class="input-group input-group-sm" style="width: 280px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Search handouts..."
                    data-target="handouts.searchInput" data-action="input->handouts#filterCourses">
            </div>
        </div>
    </div>
    <%- include('../partials/_breadcrumb') %>

    <!-- Skeleton loader shown while data loads -->
    <div data-target="handouts.skeleton">
        <div class="mb-4">
            <div class="placeholder-glow mb-3 text-center">
                <span class="placeholder col-5" style="height:24px;border-radius:4px;"></span>
            </div>
            <div class="border rounded p-3">
                <% for(var i=0; i<5; i++) { %>
                <div class="d-flex justify-content-between align-items-center py-2 <%= i == 4 ? 'border-0' : 'border-bottom' %>">
                    <div class="col-4"><span class="placeholder"></span></div>
                    <div class="col-6"></div>
                    <div class="col-1"><span class="placeholder"></span></div>
                </div>
                <% } %>
            </div>
        </div>
        <div class="mb-4">
            <div class="placeholder-glow mb-3 text-center">
                <span class="placeholder col-5" style="height:24px;border-radius:4px;"></span>
            </div>
            <div class="border rounded p-3">
                <% for(var i=0; i<5; i++) { %>
                <div class="d-flex justify-content-between align-items-center py-2 <%= i == 4 ? 'border-0' : 'border-bottom' %>">
                    <div class="col-4"><span class="placeholder"></span></div>
                    <div class="col-6"></div>
                    <div class="col-1"><span class="placeholder"></span></div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Course content rendered by controller -->
    <div data-target="handouts.courseList"></div>

    <!-- Loading more indicator for infinite scroll -->
    <div data-target="handouts.loadingMore" class="text-center py-4" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="mb-3 mt-3">
            <div class="placeholder-glow mb-3 text-center">
                <span class="placeholder col-5" style="height:24px;border-radius:4px;"></span>
            </div>
            <div class="border rounded p-3">
                <% for(var i=0; i<5; i++) { %>
                    <div class="d-flex justify-content-between align-items-center py-2 <%= i == 4 ? 'border-0' : 'border-bottom' %>">
                        <div class="col-4"><span class="placeholder"></span></div>
                        <div class="col-6"></div>
                        <div class="col-1"><span class="placeholder"></span></div>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="mb-1">
            <div class="placeholder-glow mb-3 text-center">
                <span class="placeholder col-5" style="height:24px;border-radius:4px;"></span>
            </div>
            <div class="border rounded p-3">
                <% for(var i=0; i<5; i++) { %>
                    <div class="d-flex justify-content-between align-items-center py-2 <%= i == 4 ? 'border-0' : 'border-bottom' %>">
                        <div class="col-4"><span class="placeholder"></span></div>
                        <div class="col-6"></div>
                        <div class="col-1"><span class="placeholder"></span></div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Sentinel element for infinite scroll IntersectionObserver -->
    <div data-target="handouts.scrollSentinel" class="py-2"></div>

    <!-- Empty state -->
    <div data-target="handouts.emptyState" class="text-center py-5 d-none">
        <i class="bi bi-book display-1 text-muted mb-3"></i>
        <h5 class="text-muted">No courses found</h5>
    </div>
</div>

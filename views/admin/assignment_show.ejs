<!-- admin/assignment_show.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Assignment</h1>
      <p class="text-muted mb-0">
        <%= assignment.courseCode %> &mdash; <%= assignment.courseName %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <a href="/assignments/<%= assignment.id %>/edit" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-pencil"></i> Edit
      </a>
      <form action="/assignments/<%= assignment.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this assignment?')">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-trash"></i> Delete
        </button>
      </form>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              <p class="small text-muted mb-0">Title</p>
              <p class="fw-medium mb-0"><%= assignment.title %></p>
            </div>
            <div class="col-12">
              <p class="small text-muted mb-1">Description</p>
              <p class="fw-medium mb-0"><%= assignment.description || '-' %></p>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Due Date</p>
              <p class="fw-medium mb-0"><%= assignment.dueDate ? new Date(assignment.dueDate).toLocaleDateString() : '-' %></p>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Status</p>
              <span class="badge bg-<%= assignment.status === 'publish' ? 'success' : (assignment.status === 'draft' ? 'secondary' : 'warning') %>">
                <%= assignment.status %>
              </span>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Created</p>
              <p class="fw-medium mb-0"><%= assignment.createdAt ? new Date(assignment.createdAt).toLocaleDateString() : '-' %></p>
            </div>
            <div class="col-12">
              <p class="small text-muted mb-1">File Path / URL</p>
              <% if (assignment.filePath) { %>
                <a href="<%= assignment.filePath %>" target="_blank" class="btn btn-primary btn-sm">
                  <i class="bi bi-file-earmark-pdf me-1"></i> View File
                </a>
              <% } else { %>
                <span class="text-muted">No file attached</span>
              <% } %>
            </div>
            <div class="col-12">
              <p class="small text-muted mb-1">Original Filename</p>
              <p class="fw-medium mb-0"><%= assignment.originalFilename || '-' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-bottom">
          <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Details</h6>
        </div>
        <div class="card-body">
          <p class="mb-1"><strong>ID:</strong> <%= assignment.id %></p>
          <p class="mb-1"><strong>Course Code:</strong> <%= assignment.courseCode %></p>
          <p class="mb-0"><strong>Author ID:</strong> <%= assignment.authorId || '-' %></p>
        </div>
      </div>
    </div>
  </div>
</div>

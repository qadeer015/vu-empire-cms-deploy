<!-- admin/pastpaper_show.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Past Paper</h1>
      <p class="text-muted mb-0">
        <%= paper.courseCode %> &mdash; <%= paper.courseName %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <a href="/pastpapers/<%= paper.id %>/edit" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-pencil"></i> Edit
      </a>
      <form action="/pastpapers/<%= paper.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this past paper?')">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-trash"></i> Delete
        </button>
      </form>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-4">
              <p class="small text-muted mb-0">Year</p>
              <p class="fw-medium mb-0"><%= paper.year || '-' %></p>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Type</p>
              <p class="fw-medium mb-0"><%= paper.type || '-' %></p>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Semester</p>
              <p class="fw-medium mb-0"><%= paper.semester || '-' %></p>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Status</p>
              <span class="badge bg-<%= paper.status === 'publish' ? 'success' : (paper.status === 'draft' ? 'secondary' : 'warning') %>">
                <%= paper.status %>
              </span>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">File Size</p>
              <p class="fw-medium mb-0"><%= paper.fileSize ? paper.fileSize.toLocaleString() + ' bytes' : '-' %></p>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Created</p>
              <p class="fw-medium mb-0"><%= paper.createdAt ? new Date(paper.createdAt).toLocaleDateString() : '-' %></p>
            </div>
            <div class="col-12">
              <p class="small text-muted mb-1">File Path / URL</p>
              <% if (paper.filePath) { %>
                <a href="<%= paper.filePath %>" target="_blank" class="btn btn-primary btn-sm">
                  <i class="bi bi-file-earmark-pdf me-1"></i> View Paper
                </a>
              <% } else { %>
                <span class="text-muted">No file attached</span>
              <% } %>
            </div>
            <div class="col-12">
              <p class="small text-muted mb-1">Original Filename</p>
              <p class="fw-medium mb-0"><%= paper.originalFilename || '-' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-bottom">
          <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Details</h6>
        </div>
        <div class="card-body">
          <p class="mb-1"><strong>ID:</strong> <%= paper.id %></p>
          <p class="mb-1"><strong>Course ID:</strong> <%= paper.courseId %></p>
          <p class="mb-0"><strong>Author ID:</strong> <%= paper.authorId || '-' %></p>
        </div>
      </div>
    </div>
  </div>
</div>

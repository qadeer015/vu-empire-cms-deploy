<!-- admin/gdb_show.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">GDB Solution</h1>
      <p class="text-muted mb-0">
        <%= solution.courseCode %> &mdash; <%= solution.courseName %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <a href="/gdb-solutions/<%= solution.id %>/edit" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-pencil"></i> Edit
      </a>
      <form action="/gdb-solutions/<%= solution.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this GDB solution?')">
        <button type="submit" class="btn btn-sm btn-outline-danger">
          <i class="bi bi-trash"></i> Delete
        </button>
      </form>
    </div>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-12">
              <p class="small text-muted mb-0">GDB Topic</p>
              <p class="fw-medium mb-0"><%= solution.gdbTitle %></p>
            </div>
            <div class="col-12">
              <p class="small text-muted mb-1">Solution</p>
              <p class="fw-medium mb-0" style="white-space: pre-wrap;"><%= solution.solution %></p>
            </div>
            <div class="col-md-4">
              <p class="small text-muted mb-0">Created</p>
              <p class="fw-medium mb-0"><%= solution.createdAt ? new Date(solution.createdAt).toLocaleDateString() : '-' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-bottom">
          <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Details</h6>
        </div>
        <div class="card-body">
          <p class="mb-1"><strong>ID:</strong> <%= solution.id %></p>
          <p class="mb-1"><strong>Course Code:</strong> <%= solution.courseCode %></p>
          <p class="mb-0"><strong>Author ID:</strong> <%= solution.authorId || '-' %></p>
        </div>
      </div>
    </div>
  </div>
</div>

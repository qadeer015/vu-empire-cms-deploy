<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-adsense-account" content="ca-pub-5595834937390441">

  <!-- Primary SEO -->
  <title><%= (typeof seo !== 'undefined' && seo.title) ? seo.title : (title || 'VU Empire') %></title>
  <meta name="description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'VU Empire - Your ultimate platform for VU past papers, quizzes, handouts, and study resources for Virtual University students.' %>">
  <meta name="keywords" content="<%= (typeof seo !== 'undefined' && seo.keywords) ? seo.keywords : 'VU Empire, Virtual University, VU past papers, VU quizzes, VU handouts, online学习' %>">
  <meta name="author" content="VU Empire">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= (typeof seo !== 'undefined' && seo.canonical) ? seo.canonical : 'https://vuempire.online' + (typeof currentPage !== 'undefined' ? '/' + currentPage : '') %>">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="<%= (typeof seo !== 'undefined' && seo.ogType) ? seo.ogType : 'website' %>">
  <meta property="og:url" content="<%= (typeof seo !== 'undefined' && seo.canonical) ? seo.canonical : 'https://vuempire.online' + (typeof currentPage !== 'undefined' ? '/' + currentPage : '') %>">
  <meta property="og:title" content="<%= (typeof seo !== 'undefined' && seo.title) ? seo.title : 'VU Empire' %>">
  <meta property="og:description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Your ultimate platform for VU past papers, quizzes, handouts, and study resources.' %>">
  <meta property="og:image" content="<%= (typeof seo !== 'undefined' && seo.image) ? seo.image : 'https://vuempire.online/assets/brand/logo.png' %>">
  <meta property="og:site_name" content="VU Empire">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= (typeof seo !== 'undefined' && seo.title) ? seo.title : 'VU Empire' %>">
  <meta name="twitter:description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Your ultimate platform for VU past papers, quizzes, handouts, and study resources.' %>">
  <meta name="twitter:image" content="<%= (typeof seo !== 'undefined' && seo.image) ? seo.image : 'https://vuempire.online/assets/brand/logo.png' %>">

  <!-- JSON-LD Structured Data -->
  <% if (typeof seo !== 'undefined' && seo.jsonLd) { %>
  <script type="application/ld+json">
    <%- JSON.stringify(seo.jsonLd) %>
  </script>
  <% } else { %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "VU Empire",
      "url": "https://vuempire.online",
      "description": "Your ultimate platform for VU past papers, quizzes, handouts, and study resources.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://vuempire.online/api/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
  <% } %>

  <%if(user){%>
  <meta name="user-role" content="<%= user.role %>">
  <meta name="user-id" content="<%= user.id %>">
  <input type="hidden" data-user-id="<%= user.studentId %>" value="<%= user.studentId %>">
  <%}%>


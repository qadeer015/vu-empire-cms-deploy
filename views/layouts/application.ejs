    <!-- Form Protector: intercepts form submissions before controllers are ready -->
    <script>
    // This runs synchronously during HTML parsing, before any form is rendered.
    // It intercepts submit events on forms inside [data-controller] elements
    // that haven't yet been marked data-controller-ready="true" by the framework.
    (function() {
        var _pending = new Map();
        var _interval = null;

        document.addEventListener('submit', function(e) {
            var form = e.target;
            if (!form || form.tagName !== 'FORM') return;

            var controllerEl = form.closest('[data-controller]');
            if (!controllerEl) return;
            if (controllerEl.getAttribute('data-controller-ready') === 'true') return;

            e.preventDefault();
            e.stopPropagation();

            var btn = form.querySelector('[type="submit"]');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing...';
            }

            if (!_pending.has(controllerEl)) {
                _pending.set(controllerEl, { form: form, button: btn });
            }

            if (!_interval) {
                _interval = setInterval(function() {
                    var hasPending = false;
                    for (var entry of _pending) {
                        var el = entry[0], item = entry[1];
                        if (el.getAttribute('data-controller-ready') === 'true') {
                            if (item.button) item.button.disabled = false;
                            try { item.form.requestSubmit(); } catch(err) { item.form.submit(); }
                            _pending.delete(el);
                        } else {
                            hasPending = true;
                        }
                    }
                    if (!hasPending && _interval) {
                        clearInterval(_interval);
                        _interval = null;
                    }
                }, 50);
            }
        }, true);
    })();
    </script>


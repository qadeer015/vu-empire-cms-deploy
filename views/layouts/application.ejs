<body>
    <% if (header) { %>
  <%- include('../partials/_navbar') %>
  <% } %>
  <!-- Mobile Menu Button -->
  <% if (sidebar && user && currentPage !== 'home' && currentPage !== 'genie-landing') { %>
  <button class="btn btn-primary d-md-none position-fixed top-50 start-0 translate-middle-y ms-3 z-3 shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar" style="border-radius: 50%; width: 48px; height: 48px; padding: 0;">
    <i class="bi bi-menu-button-wide fs-5"></i>
  </button>
  <% } %>

  <!-- Mobile Offcanvas Sidebar -->
  <% if (sidebar && user && currentPage !== 'home' && currentPage !== 'genie-landing') { %>
  <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel" style="width: 280px;">
    <div class="offcanvas-header border-bottom">
      <h5 class="offcanvas-title" id="mobileSidebarLabel">
        <a class="navbar-brand d-flex align-items-center gap-1" href="/" aria-label="VU Empire" title="VU Empire">
          <img src="/assets/brand/logo.png" width="20px" class="me-2" alt="VU Empire Logo">
          <div class="text-body-emphasis">
            <span class="brand-text d-md-block d-none" style="font-size: 18px;">VU <span>Empire CMS</span></span>
            <span class="brand-text d-md-none" style="font-size: 18px;"><span>CMS</span></span>
          </div>
        </a>
      </h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
      <div class="d-flex flex-column gap-1 p-2 h-100 position-sticky sidebar" style="top:86px">
        <p class="text-uppercase text-muted px-3 mb-1" style="font-size: 11px; letter-spacing: .05em;"></p>
        <% if (user.role==='admin' ) { %>
        <%- include('../partials/_sidebar') %>
        <% } %>
        <form action="/api/auth/logout?_method=DELETE" method="POST" class="sidebar-link d-inline">
          <button type="submit" onclick="return confirm('Are you sure to logout?')" class="btn p-0 border-0 outline-0 text-danger">
            <i class="bi bi-box-arrow-right me-2"></i> Logout
          </button>
        </form>
      </div>
    </div>
  </div>
  <% } %>

  <main class="min-vh-75">
    <% if ( currentPage !== "genie-landing" ) { %>
    <!-- Student sidebar layout -->
    <div>
      <div>
        <div class="row g-0 min-vh-75">
          <% if (sidebar && user) { %>
          <!-- Desktop Sidebar - hidden on mobile -->
          <div class="col-auto d-none d-md-block z-1">
            <div class="d-flex flex-column gap-1 p-2 position-sticky sidebar" style="max-height: 75vh; top: 86px;">
              <p class="text-uppercase text-muted px-3 mb-1" style="font-size: 11px; letter-spacing: .05em;"></p>
              <% if (user.role==='admin') { %>
              <%- include('../partials/_sidebar') %>
              <% } %>
            </div>
          </div>
          <% } %>
          <div class="col z-0 py-3">
            <%- body %>
          </div>
        </div>
      </div>
    </div>
    <% } else { %>
    <%- body %>
    <% } %>
  </main>
  <% if (footer) { %>
  <%- include('../partials/_footer') %>
  <% } %>
<script>
  const filterBtn = document.querySelector('.filter-btn');
  const filterArea = document.querySelector('.filter-area');
  filterBtn?.addEventListener('click', function() {
    filterArea?.classList.contains('d-none') ? filterArea.classList.remove('d-none') : filterArea.classList.add('d-none');
  });
</script>
  </body>


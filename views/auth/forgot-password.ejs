<%- include('_nav') %>
    <div class="container my-5" data-controller="auth" data-action="forgot">

        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-9 col-12">
                <div class="card border-0">
                    <div class="card-body">
                        <div class="card-title text-center">
                            <h2>Forgot Password</h2>
                            <p>Enter your vu or personal email address that you used to in your vu profile. We'll send
                                you an email with a link to reset your
                                password.</p>
                        </div>
                        <div class="row justify-content-center mt-4">
                            <div class="col-md-9 col-12">
                                <form data-target="auth.form">
                                    <div class="form-group mb-3">
                                        <input type="email" class="form-control p-3" id="email" placeholder="Email" autocomplete="off"
                                            data-target="auth.identifier" required>
                                    </div>

                                    <div class="form-group mt-3">
                                        Don't want to reset your password?
                                        <a href="/auth/login" class="hover-underline">Sign In</a>
                                    </div>

                                    <div class="text-center mt-4">
                                        <button type="submit" class="btn btn-lg btn-primary rounded-pill">Send Reset
                                            Link</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
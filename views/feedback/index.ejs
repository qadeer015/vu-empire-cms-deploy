<!-- feedback/index.ejs -->
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Feedback</h1>
    <span class="badge bg-primary"><%= total %> items</span>
  </div>
  <%- include('../partials/_breadcrumb') %>

  <!-- Search & Filter -->
  <div class="row">
    <div class="col-12">
      <button class="btn btn-outline-secondary my-3 filter-btn" type="button">
        <i class="bi bi-funnel"></i>
        Filters
      </button>
      <form method="GET" action="/feedback" class="mb-3 filter-area d-none">
        <input type="hidden" name="tab" value="<%= activeTab %>">
        <div class="d-flex flex-column g-2 align-items-start">
          <div class="col-sm-3 col-md-3">
            <label for="feedbackSearch" class="form-label small text-muted">
              Search <%= activeTab === 'subscribers' ? '(subscriber email)' : '(title, description or email)' %>
            </label>
            <input type="text" class="form-control form-control-sm" id="feedbackSearch" name="q" placeholder="<%= activeTab === 'subscribers' ? 'Search by email...' : 'Search requests...' %>" value="<%= typeof q !== 'undefined' ? q : '' %>">
          </div>
          <% if (activeTab !== 'subscribers') { %>
          <div class="col-sm-3 col-md-3 fr-only">
            <label for="statusFilter" class="form-label small text-muted">Status</label>
            <select class="form-select form-select-sm" id="statusFilter" name="status">
              <option value="all" <%= (typeof status === 'undefined' || status === 'all') ? 'selected' : '' %>>All</option>
              <option value="new" <%= typeof status !== 'undefined' && status === 'new' ? 'selected' : '' %>>New</option>
              <option value="in progress" <%= typeof status !== 'undefined' && status === 'in progress' ? 'selected' : '' %>>In Progress</option>
              <option value="completed" <%= typeof status !== 'undefined' && status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="done" <%= typeof status !== 'undefined' && status === 'done' ? 'selected' : '' %>>Done</option>
              <option value="rejected" <%= typeof status !== 'undefined' && status === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>
          </div>
          <div class="col-sm-3 col-md-3 fr-only">
            <label for="typeFilter" class="form-label small text-muted">Type</label>
            <select class="form-select form-select-sm" id="typeFilter" name="type">
              <option value="all" <%= (typeof type === 'undefined' || type === 'all') ? 'selected' : '' %>>All</option>
              <option value="bug" <%= typeof type !== 'undefined' && type === 'bug' ? 'selected' : '' %>>Bug</option>
              <option value="improvement" <%= typeof type !== 'undefined' && type === 'improvement' ? 'selected' : '' %>>Improvement</option>
              <option value="enhancement" <%= typeof type !== 'undefined' && type === 'enhancement' ? 'selected' : '' %>>Enhancement</option>
            </select>
          </div>
          <div class="col-sm-3 col-md-3 sub-only <%= activeTab === 'subscribers' ? '' : 'd-none' %>">
            <label for="subStatusFilter" class="form-label small text-muted">Status</label>
            <select class="form-select form-select-sm" id="subStatusFilter" name="subStatus">
              <option value="all" <%= (typeof subStatus === 'undefined' || subStatus === 'all') ? 'selected' : '' %>>All</option>
              <option value="active" <%= typeof subStatus !== 'undefined' && subStatus === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= typeof subStatus !== 'undefined' && subStatus === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
          <div class="col-sm-3 col-md-3 sub-only <%= activeTab === 'subscribers' ? '' : 'd-none' %>">
            <label for="subscribedDateFilter" class="form-label small text-muted">Subscribed Date</label>
            <input type="date" class="form-control form-control-sm" id="subscribedDateFilter" name="subscribedDate" value="<%= typeof subscribedDate !== 'undefined' ? subscribedDate : '' %>">
          </div>
          <% } %>
          <div class="col-sm-2 mt-3">
            <div class="d-flex gap-2">
              <a href="/feedback?tab=<%= activeTab %>" class="btn btn-outline-secondary btn-sm w-100">
                <i class="bi bi-x-lg"></i>
                <span>Reset</span>
              </a>
              <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-check-lg"></i>
                <span>Apply</span>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>

  <ul class="nav nav-tabs mb-3" role="tablist" id="feedbackTabs">
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= activeTab === 'requests' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#featureRequests" type="button" role="tab">
        <i class="bi bi-lightbulb"></i> Feature Requests
        <span class="badge bg-secondary ms-1"><%= featureRequests.length %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= activeTab === 'subscribers' ? 'active' : '' %>" data-bs-toggle="tab" data-bs-target="#subscribers" type="button" role="tab">
        <i class="bi bi-envelope"></i> Newsletter Subscribers
        <span class="badge bg-secondary ms-1"><%= subscribers.length %></span>
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <!-- Feature Requests Tab -->
    <div class="tab-pane fade <%= activeTab === 'requests' ? 'show active' : '' %>" id="featureRequests" role="tabpanel">
      <% if (featureRequests.length > 0) { %>
      <table class="table table-hover align-middle">
        <thead>
          <tr class="sticky-table-header">
            <th>#</th>
            <th>Title</th>
            <th>Description</th>
            <th>User</th>
            <th>Status</th>
            <th>Type</th>
            <th>Submitted</th>
          </tr>
        </thead>
        <tbody>
          <% featureRequests.forEach(function (r, i) { %>
          <tr class="feature-request-row" role="button" data-index="<%= i %>">
            <td class="text-muted small"><%= i + 1 %></td>
            <td class="fw-medium"><%= r.title || r.name || '—' %></td>
            <td class="text-muted small" style="max-width: 380px;">
              <span class="d-inline-block text-truncate" style="max-width: 380px;" title="<%= r.description || r.message || r.details || '' %>">
                <%= r.description || r.message || r.details || '—' %>
              </span>
            </td>
            <td class="small"><%= r.email || r.userEmail || r.submittedBy || '—' %></td>
            <td>
              <% const st = (r.status || 'new').toLowerCase(); %>
              <span class="badge bg-<%= st === 'completed' || st === 'done' ? 'success' : (st === 'in progress' ? 'warning' : (st === 'rejected' ? 'danger' : 'secondary')) %>">
                <%= r.status || 'new' %>
              </span>
            </td>
            <td class="small">
              <% const ftype = r.type || '—'; %>
              <span class="badge bg-<%= ftype.toLowerCase() === 'bug' ? 'danger' : (ftype.toLowerCase() === 'improvement' || ftype.toLowerCase() === 'enhancement' ? 'info' : 'secondary') %> text-uppercase">
                <%= ftype %>
              </span>
            </td>
            <td class="text-muted small"><%= r.createdAt ? new Date(r.createdAt.toDate ? r.createdAt.toDate() : r.createdAt).toLocaleString() : '—' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } else { %>
      <div class="text-center py-5">
        <i class="bi bi-lightbulb display-1 text-muted mb-3"></i>
        <h5 class="text-muted">No feature requests found</h5>
      </div>
      <% } %>
    </div>

    <!-- Newsletter Subscribers Tab -->
    <div class="tab-pane fade <%= activeTab === 'subscribers' ? 'show active' : '' %>" id="subscribers" role="tabpanel">
      <% if (subscribers.length > 0) { %>
      <table class="table table-hover align-middle">
        <thead>
          <tr class="sticky-table-header">
            <th>#</th>
            <th>Email</th>
            <th>Status</th>
            <th>Subscribed</th>
          </tr>
        </thead>
        <tbody>
          <% subscribers.forEach(function (s, i) { %>
          <tr>
            <td class="text-muted small"><%= i + 1 %></td>
            <td class="fw-medium"><%= s.email || s.subscriberEmail || '—' %></td>
            <td>
              <% const st = (s.status || 'active').toLowerCase(); %>
              <span class="badge bg-<%= st === 'active' || st === 'subscribed' ? 'success' : 'secondary' %>"><%= s.status || 'active' %></span>
            </td>
            <td class="text-muted small"><%= (s.createdAt || s.subscribedAt) ? new Date((s.createdAt || s.subscribedAt).toDate ? (s.createdAt || s.subscribedAt).toDate() : (s.createdAt || s.subscribedAt)).toLocaleString() : '—' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } else { %>
      <div class="text-center py-5">
        <i class="bi bi-envelope display-1 text-muted mb-3"></i>
        <h5 class="text-muted">No newsletter subscribers found</h5>
      </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Feature Request Detail Modal -->
<div class="modal fade" id="featureRequestModal" tabindex="-1" aria-labelledby="featureRequestModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="featureRequestModalLabel">Feature Request</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <h4 id="frTitle" class="mb-1">—</h4>
        <div id="frMeta" class="mb-3 d-flex flex-wrap gap-2"></div>
        <h6 class="text-muted text-uppercase small">Description</h6>
        <p id="frDescription" class="mb-3" style="white-space: pre-wrap;">—</p>
        <h6 class="text-muted text-uppercase small">Other Details</h6>
        <dl id="frOtherDetails" class="row row-cols-1 row-cols-sm-2 g-2 mb-0"></dl>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    // Tab <-> URL <-> filter-form synchronization for the feedback page.
    // Canonical tab values are 'requests' and 'subscribers' (the #featureRequests
    // pane id must NOT leak into the URL as tab=featureRequests).
    var tabs = document.querySelectorAll('#feedbackTabs button[data-bs-toggle="tab"]');
    if (!tabs.length) return;

    var tabInput = document.querySelector('.filter-area input[name="tab"]');
    var searchLabel = document.querySelector('label[for="feedbackSearch"]');
    var searchInput = document.getElementById('feedbackSearch');
    var filterArea = document.querySelector('.filter-area');

    // Field groups per tab: fr-only = feature requests, sub-only = subscribers
    var frGroups = Array.prototype.slice.call(document.querySelectorAll('.filter-area .fr-only'));
    var subGroups = Array.prototype.slice.call(document.querySelectorAll('.filter-area .sub-only'));

    // Map a tab pane target (e.g. "#featureRequests") to its canonical tab param
    function targetToTab(target) {
      return target === '#subscribers' ? 'subscribers' : 'requests';
    }

    function setGroupState(groups, show) {
      groups.forEach(function (group) {
        group.classList.toggle('d-none', !show);
        group.querySelectorAll('input, select').forEach(function (el) {
          if (show) el.removeAttribute('disabled');
          else el.setAttribute('disabled', 'disabled');
        });
      });
    }

    function syncFilterForm(tabName) {
      var isSubscribers = tabName === 'subscribers';

      // Keep the form submitting to the active tab
      if (tabInput) tabInput.value = tabName;

      // Show/hide (and enable/disable) the per-tab filter fields
      setGroupState(frGroups, !isSubscribers);
      setGroupState(subGroups, isSubscribers);

      // Adjust search labels/placeholders per tab
      if (searchLabel) {
        searchLabel.innerHTML = 'Search ' + (isSubscribers ? '(subscriber email)' : '(title, description or email)');
      }
      if (searchInput) {
        searchInput.placeholder = isSubscribers ? 'Search by email...' : 'Search requests...';
      }

      // Reset link should point at the active tab
      var resetLink = document.querySelector('.filter-area a[href^="/feedback"]');
      if (resetLink) resetLink.setAttribute('href', '/feedback?tab=' + tabName);
    }

    // Write the canonical tab value into the URL, preserving filter params
    function updateUrlTab(tabName) {
      var url = new URL(window.location.href);
      url.searchParams.set('tab', tabName);
      window.history.replaceState(null, '', url);
    }

    // ── On page load ─────────────────────────────────────────────
    var initialTab;
    var url = new URL(window.location.href);
    var urlTab = url.searchParams.get('tab');

    if (urlTab === 'featureRequests' || urlTab === 'requests') {
      initialTab = 'requests';
      // Normalize legacy/mismatched value so the URL is always canonical
      if (urlTab === 'featureRequests') updateUrlTab('requests');
    } else if (urlTab === 'subscribers') {
      initialTab = 'subscribers';
    } else {
      // No tab in URL — derive it from the tab button marked active server-side
      var activeBtn = document.querySelector('#feedbackTabs button.active');
      initialTab = activeBtn ? targetToTab(activeBtn.getAttribute('data-bs-target')) : 'requests';
      updateUrlTab(initialTab);
    }
    syncFilterForm(initialTab);

    // Re-open the filter panel automatically when a filter is applied,
    // so all options are visible without needing a hard refresh.
    var hasActiveFilter = ['q', 'status', 'type', 'subStatus', 'subscribedDate']
      .some(function (p) { return url.searchParams.get(p); });
    if (hasActiveFilter && filterArea) {
      filterArea.classList.remove('d-none');
    }

    // ── On tab switch ────────────────────────────────────────────
    tabs.forEach(function (tab) {
      tab.addEventListener('shown.bs.tab', function (event) {
        var tabName = targetToTab(event.target.getAttribute('data-bs-target'));

        // Update ?tab= in the URL, preserving other filter params
        updateUrlTab(tabName);

        // Keep the filter form in sync with the now-active tab
        syncFilterForm(tabName);
      });
    });
  })();
</script>

<script>
  window.__featureRequestsData = <%- JSON.stringify(featureRequests).replace(/</g, '\\u003c') %>;
</script>
<script>
  (function () {
    var modalEl = document.getElementById('featureRequestModal');
    if (!modalEl || typeof bootstrap === 'undefined') return;
    var modal = new bootstrap.Modal(modalEl);

    var esc = function (s) {
      var d = document.createElement('div');
      d.textContent = s === null || s === undefined ? '' : String(s);
      return d.innerHTML;
    };
    var dateFmt = function (v) {
      if (!v) return '—';
      try {
        var d = v.toDate ? v.toDate() : new Date(v);
        return isNaN(d.getTime()) ? '—' : d.toLocaleString();
      } catch (e) { return '—'; }
    };
    var statusBadge = function (status) {
      var st = (status || 'new').toLowerCase();
      var color = st === 'completed' || st === 'done' ? 'success'
        : st === 'in progress' ? 'warning'
        : st === 'rejected' ? 'danger' : 'secondary';
      return '<span class="badge bg-' + color + '">' + esc(status || 'new') + '</span>';
    };
    var typeBadge = function (type) {
      if (!type) type = '—';
      var t = type.toLowerCase();
      var color = t === 'bug' ? 'danger' : (t === 'improvement' || t === 'enhancement' ? 'info' : 'secondary');
      return '<span class="badge bg-' + color + ' text-uppercase">' + esc(type) + '</span>';
    };

    var KNOWN_FIELDS = ['title', 'name', 'description', 'message', 'details',
      'email', 'userEmail', 'submittedBy', 'status', 'type', 'createdAt'];

    document.querySelectorAll('.feature-request-row').forEach(function (row) {
      row.addEventListener('click', function () {
        var idx = parseInt(row.getAttribute('data-index'), 10);
        var r = window.__featureRequestsData && window.__featureRequestsData[idx];
        if (!r) return;

        // Move the modal to document.body before showing it.
        // The modal otherwise renders inside the content column (z-0), whose
        // sibling sidebar (z-1) / header / floating buttons (z-3) create their
        // own stacking contexts and would paint above the backdrop (z-1050).
        if (modalEl.parentNode !== document.body) {
          document.body.appendChild(modalEl);
        }

        document.getElementById('frTitle').textContent = r.title || r.name || 'Untitled request';

        document.getElementById('frMeta').innerHTML =
          statusBadge(r.status) + ' ' + typeBadge(r.type) +
          '<span class="badge bg-light text-dark border">' + esc(dateFmt(r.createdAt)) + '</span>';

        document.getElementById('frDescription').textContent =
          r.description || r.message || r.details || '—';

        var meta = [
          ['Email', r.email || r.userEmail || r.submittedBy],
          ['Submitted', dateFmt(r.createdAt)]
        ];
        Object.keys(r).forEach(function (k) {
          if (KNOWN_FIELDS.indexOf(k) === -1) {
            var v = r[k];
            if (v && typeof v === 'object') v = JSON.stringify(v);
            meta.push([k, v]);
          }
        });

        var dl = document.getElementById('frOtherDetails');
        dl.innerHTML = meta.map(function (m) {
          return '<div class="col"><dt class="small text-muted mb-0">' + esc(m[0]) +
            '</dt><dd class="mb-1 text-break">' + esc(m[1] || '—') + '</dd></div>';
        }).join('');

        modal.show();
      });
    });
  })();
</script>